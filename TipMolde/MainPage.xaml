<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.MainPage">
    <Grid ColumnDefinitions="280,*" ColumnSpacing="0">
        <Border Grid.Column="0"
                Background="{StaticResource SidebarGradientBrush}"
                StrokeThickness="0"
                Padding="28,28,24,24">
            <Grid RowDefinitions="Auto,*,Auto">
                <VerticalStackLayout Spacing="28">
                    <HorizontalStackLayout Spacing="16">
                        <Grid WidthRequest="62"
                              HeightRequest="62">
                            <Grid.Clip>
                                <RoundRectangleGeometry CornerRadius="18"
                                                        Rect="0,0,62,62" />
                            </Grid.Clip>
                            <Image Source="image.png"
                                   Aspect="AspectFill" />
                        </Grid>

                        <VerticalStackLayout Spacing="2" VerticalOptions="Center">
                            <Label Text="TipMolde"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="30"
                                   TextColor="White" />
                            <Label Text="Sistema de Producao"
                                   FontSize="13"
                                   TextColor="#CBD5E1" />
                        </VerticalStackLayout>
                    </HorizontalStackLayout>
                </VerticalStackLayout>

                <VerticalStackLayout Grid.Row="1" Spacing="12" VerticalOptions="Start">
                    <Border Background="#10B981" StrokeThickness="0" Padding="20,16">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="18" />
                        </Border.StrokeShape>
                        <Label Text="Dashboard"
                               FontFamily="OpenSansSemibold"
                               FontSize="22"
                               TextColor="White" />
                    </Border>

                    <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="18,14">
                        <Label Text="Utilizadores" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#E2E8F0" />
                    </Border>

                    <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="18,14">
                        <Label Text="Clientes" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#E2E8F0" />
                    </Border>

                    <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="18,14">
                        <Label Text="Encomendas" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#E2E8F0" />
                    </Border>

                    <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="18,14">
                        <Label Text="Producao" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#E2E8F0" />
                    </Border>

                    <Border BackgroundColor="Transparent" StrokeThickness="0" Padding="18,14">
                        <Label Text="Definicoes" FontFamily="OpenSansSemibold" FontSize="18" TextColor="#E2E8F0" />
                    </Border>
                </VerticalStackLayout>
            </Grid>
        </Border>

        <Grid Grid.Column="1" RowDefinitions="Auto,*" BackgroundColor="{StaticResource Surface}">
            <Border Padding="28,22"
                    Margin="0,0,0,2"
                    BackgroundColor="White"
                    StrokeThickness="0">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="20">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Sistema de Gestao de Producao"
                               FontFamily="OpenSansSemibold"
                               FontSize="28"
                               TextColor="{StaticResource TextPrimary}" />
                    </VerticalStackLayout>

                    <HorizontalStackLayout Grid.Column="1" Spacing="14" VerticalOptions="Center">

                        <Border Background="#F1F5F9" StrokeThickness="0" Padding="16,8">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Label Text="Ricardo Magalhaes" FontFamily="OpenSansSemibold" />
                        </Border>
                    </HorizontalStackLayout>
                </Grid>
            </Border>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="28" Spacing="24">
                    <Border Background="{StaticResource BrandGradientBrush}"
                            StrokeThickness="0"
                            Padding="34">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>
                        <Grid ColumnDefinitions="1.05*,0.95*" ColumnSpacing="28">
                            <VerticalStackLayout Spacing="18">
                                <Label Text="Dashboard do moldemais próximo de entrega"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="34"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                                <HorizontalStackLayout Spacing="12">
                                    <Button Text="Apresentar dashboard"
                                            WidthRequest="220" />
                                </HorizontalStackLayout>
                            </VerticalStackLayout>

                            <Border Grid.Column="1"
                                    Background="#F8FAFC"
                                    StrokeThickness="0"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Image Source="dashboard_preview.svg"
                                       Aspect="AspectFit"
                                       HeightRequest="240" />
                            </Border>
                        </Grid>
                    </Border>

                    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="18">
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="24">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Moldes Ativos" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="5" FontFamily="OpenSansSemibold" FontSize="38" />
                                <Label Text="Em producao neste momento" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="24">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Taxa de Conclusao" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="64.2%" FontFamily="OpenSansSemibold" FontSize="38" />
                                <Label Text="Media geral dos projetos" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="24">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Concluidos" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="12" FontFamily="OpenSansSemibold" FontSize="38" />
                                <Label Text="Projetos fechados este trimestre" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="3"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="24">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Com Atraso" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="1" FontFamily="OpenSansSemibold" FontSize="38" />
                                <Label Text="Precisa de atencao esta semana" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Ecras principais"
                               FontFamily="OpenSansSemibold"
                               FontSize="28" 
                               TextColor="{StaticResource TextPrimary}"/>
                        <Label Text="Troquei os placeholders por previews locais em SVG que podes reutilizar em cards, login ou splash."
                               FontSize="15"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="18">
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="dashboard_preview.svg" HeightRequest="170" Aspect="AspectFit" />
                                <Label Text="Dashboard executivo" FontFamily="OpenSansSemibold" FontSize="20" />
                                <Label Text="Cards de KPI, progresso e estrutura limpa para demo em reuniao."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="1"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="clients_preview.svg" HeightRequest="170" Aspect="AspectFit" />
                                <Label Text="Gestao de clientes" FontFamily="OpenSansSemibold" FontSize="20" />
                                <Label Text="Cartoes bem definidos para contactos, empresas e acoes rapidas."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="2"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="production_preview.svg" HeightRequest="170" Aspect="AspectFit" />
                                <Label Text="Producao em curso" FontFamily="OpenSansSemibold" FontSize="20" />
                                <Label Text="Barras de estado e foco visual nas prioridades do chao de fabrica."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <Grid ColumnDefinitions="1.1*,0.9*" ColumnSpacing="18">
                        <Border Grid.Column="0"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="26">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Pipeline de projeto"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="26" />
                                <Label Text="Uma secao pronta para substituir os retangulos vazios do mockup por progresso real ou valores demonstrativos."
                                       FontSize="15"
                                       TextColor="{StaticResource TextSecondary}" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Tampa Producao P12" FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.84" HeightRequest="10" />
                                        <Label Text="84% concluido" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Background="#ECFDF5" StrokeThickness="0" Padding="10,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Em curso" TextColor="{StaticResource BrandGreenDark}" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Conector Automovel A7" FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.62" HeightRequest="10" />
                                        <Label Text="62% concluido" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Background="#FEF3C7" StrokeThickness="0" Padding="10,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Atencao" TextColor="{StaticResource Warning}" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Carcaca Filtro B9" FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.95" HeightRequest="10" />
                                        <Label Text="95% concluido" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Background="#DBEAFE" StrokeThickness="0" Padding="10,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Validacao" TextColor="{StaticResource Info}" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Column="1" Spacing="18">
                            <Border BackgroundColor="White"
                                    Stroke="{StaticResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    Padding="24">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="10">
                                    <Label Text="Ligacao ao backend"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="24" />
                                    <Label x:Name="StatusLabel"
                                           Text="A verificar ligacao..."
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18" />
                                    <Label x:Name="DetailsLabel"
                                           Text="A app vai testar automaticamente o endpoint da API ao abrir."
                                           FontSize="14"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="WordWrap" />
                                    <Label x:Name="EndpointLabel"
                                           Text="Endpoint: por resolver"
                                           FontSize="13"
                                           TextColor="{StaticResource TextSecondary}" />

                                    <ActivityIndicator x:Name="ConnectionActivityIndicator"
                                                       IsRunning="False"
                                                       IsVisible="False"
                                                       HorizontalOptions="Start" />

                                    <Button x:Name="TestConnectionButton"
                                            Text="Testar ligacao"
                                            Clicked="OnTestConnectionClicked"
                                            HorizontalOptions="Fill" />
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="White"
                                    Stroke="{StaticResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    Padding="24">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <VerticalStackLayout Spacing="12">
                                    <Label Text="O que podes copiar para outros ecras"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="22" />
                                    <Label Text="Usa esta combinacao em toda a app: sidebar escura, cabecalho branco, cards com 24px de canto e previews SVG locais."
                                           FontSize="14"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="WordWrap" />
                                    <Label Text="Os ficheiros novos estao em Resources/Images e a estrutura principal ficou toda nesta MainPage."
                                           FontSize="14"
                                           TextColor="{StaticResource TextSecondary}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>

</ContentPage>
