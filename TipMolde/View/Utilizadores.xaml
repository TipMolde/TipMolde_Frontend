<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.Utilizadores"
             xmlns:viewmodel="clr-namespace:TipMolde.ViewModel"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             BackgroundColor="{StaticResource Surface}">

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="0">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource Surface}">

            <shared:TopBarView Grid.Row="0"
               TitleText="Gestão Utilizadores"
               UserNameText="Ricardo Magalhaes" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="28"
                                     Spacing="20">

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HorizontalOptions="Center" />

                    <CollectionView ItemsSource="{Binding Utilizadores}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border BackgroundColor="White"
                                    Stroke="{StaticResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    Padding="30">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Label Text="Nao existem utilizadores para apresentar."
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource TextSecondary}" />
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White"
                                        Stroke="{StaticResource CardBorderBrush}"
                                        StrokeThickness="1"
                                        Padding="22"
                                        Margin="0,0,0,16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="24" />
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="2.2*,1.4*,Auto"
                                          ColumnSpacing="18">

                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Nome}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="22"
                                                   TextColor="{StaticResource TextPrimary}" />

                                            <Label Text="{Binding Email}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextSecondary}" />

                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="Cargo:"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <Border Background="#F8FAFC"
                                                        StrokeThickness="0"
                                                        Padding="10,4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Role}"
                                                           FontSize="13"
                                                           TextColor="{StaticResource TextPrimary}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="10"
                                                             VerticalOptions="Center">
                                            <Button Text="Editar cargo"
                                                    Clicked="OnEditRoleClicked"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#E2E8F0"
                                                    TextColor="#0F172A"
                                                    CornerRadius="16"
                                                    HeightRequest="44" />

                                            <Button Text="Repor password"
                                                    Clicked="OnResetPasswordClicked"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#0F172A"
                                                    TextColor="White"
                                                    CornerRadius="16"
                                                    HeightRequest="44" />
                                        </VerticalStackLayout>

                                        <Grid Grid.Column="2"
                                              WidthRequest="18"
                                              VerticalOptions="Center">
                                            <VerticalStackLayout Spacing="5"
                                                                 HorizontalOptions="Center"
                                                                 VerticalOptions="Center">
                                                <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2" Color="#94A3B8" />
                                                <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2" Color="#94A3B8" />
                                                <BoxView WidthRequest="4" HeightRequest="4" CornerRadius="2" Color="#94A3B8" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="20"
                          Margin="0,8,0,0">

                        <Button Grid.Column="0"
                                Text="◀"
                                Command="{Binding PreviousPageCommand}"
                                IsEnabled="{Binding CanGoPrevious}" />

                        <Border Grid.Column="1"
                                HorizontalOptions="Center"
                                BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="22,12">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="18" />
                            </Border.StrokeShape>
                            <Label Text="{Binding Page}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20"
                                   TextColor="{StaticResource TextPrimary}"
                                   HorizontalOptions="Center" />
                        </Border>

                        <Button Grid.Column="2"
                                Text="▶"
                                Command="{Binding NextPageCommand}"
                                IsEnabled="{Binding CanGoNext}" />
                    </Grid>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>