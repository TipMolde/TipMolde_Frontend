<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.Utilizadores"
             x:Name="PaginaUtilizadores"
             xmlns:viewmodel="clr-namespace:TipMolde.ViewModel"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             BackgroundColor="{StaticResource Surface}">

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="0">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource Surface}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Gestão Utilizadores"/>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="28"
                                     Spacing="20">

                    <Border BackgroundColor="White"
                            Stroke="{StaticResource CardBorderBrush}"
                            StrokeThickness="1"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">
                            <Label Text="Pesquisar utilizadores"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   TextColor="{StaticResource TextPrimary}"
                                   VerticalOptions="Center" />

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="12">

                                <SearchBar Grid.Column="0"
                                           Placeholder="Pesquisar por nome"
                                           Text="{Binding SearchTerm}"
                                           TextColor="{StaticResource TextPrimary}"
                                           SearchCommand="{Binding PesquisarCommand}" />

                                <Button Grid.Column="1"
                                        Text="Pesquisar"
                                        Command="{Binding PesquisarCommand}"
                                        HeightRequest="44" />

                                <Button Grid.Column="2"
                                        Text="Limpar"
                                        Command="{Binding LimparPesquisaCommand}"
                                        IsEnabled="{Binding HasSearch}"
                                        BackgroundColor="#E2E8F0"
                                        TextColor="#0F172A"
                                        HeightRequest="44" />
                            </Grid>

                            <Label Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding HasError}"
                                   TextColor="{StaticResource Danger}"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HorizontalOptions="Center" />

                    <Button         Text="Adicionar utilizador"
                                    Command="{Binding AbrirAdicionarUtilizadorCommand}"
                                    BackgroundColor="#0F172A"
                                    TextColor="White"
                                    HeightRequest="44" />

                    <CollectionView ItemsSource="{Binding Utilizadores}"
                                    SelectionMode="None">
                        <CollectionView.EmptyView>
                            <Border BackgroundColor="White"
                                    Stroke="{StaticResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    Padding="30">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>
                                <Label Text="Nao existem utilizadores para apresentar."
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource TextSecondary}" />
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate>
                                <Border BackgroundColor="White"
                                        Stroke="{StaticResource CardBorderBrush}"
                                        StrokeThickness="1"
                                        Padding="22"
                                        Margin="0,0,0,16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="24" />
                                    </Border.StrokeShape>

                                    <Grid ColumnDefinitions="2.2*,1.4*,Auto"
                                          ColumnSpacing="18">

                                        <VerticalStackLayout Spacing="8">
                                            <Label Text="{Binding Nome}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="22"
                                                   TextColor="{StaticResource TextPrimary}" />

                                            <Label Text="{Binding Email}"
                                                   FontSize="14"
                                                   TextColor="{StaticResource TextSecondary}" />

                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="Cargo:"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="14"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <Border Background="#F8FAFC"
                                                        StrokeThickness="0"
                                                        Padding="10,4">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="12" />
                                                    </Border.StrokeShape>
                                                    <Label Text="{Binding Role}"
                                                           FontSize="13"
                                                           TextColor="{StaticResource TextPrimary}" />
                                                </Border>
                                            </HorizontalStackLayout>
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="10"
                                                             VerticalOptions="Center">
                                            <Button Text="Editar cargo"
                                                    Command="{Binding BindingContext.EditarCargoCommand, Source={x:Reference Name=PaginaUtilizadores}}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#E2E8F0"
                                                    TextColor="#0F172A"
                                                    CornerRadius="16"
                                                    HeightRequest="44" />

                                            <Button Text="Repor password"
                                                    Command="{Binding BindingContext.ReporPasswordCommand, Source={x:Reference Name=PaginaUtilizadores}}"
                                                    CommandParameter="{Binding .}"
                                                    BackgroundColor="#0F172A"
                                                    TextColor="White"
                                                    CornerRadius="16"
                                                    HeightRequest="44" />
                                        </VerticalStackLayout>

                                        <Button Grid.Column="2"
                                            Text="⋮"
                                            Command="{Binding BindingContext.AbrirOpcoesCommand, Source={x:Reference Name=PaginaUtilizadores}}"
                                            CommandParameter="{Binding .}"
                                            BackgroundColor="Transparent"
                                            TextColor="#94A3B8"
                                            FontSize="24"
                                            WidthRequest="36"
                                            HeightRequest="36"
                                            Padding="0"
                                            BorderWidth="0"
                                            VerticalOptions="Center"
                                            HorizontalOptions="Center" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <shared:PaginationBarView Page="{Binding Page}"
                          TotalPages="{Binding TotalPages}"
                          PageInput="{Binding PageInput}"
                          CanGoFirst="{Binding CanGoFirst}"
                          CanGoPrevious="{Binding CanGoPrevious}"
                          CanGoNext="{Binding CanGoNext}"
                          CanGoLast="{Binding CanGoLast}"
                          FirstPageCommand="{Binding FirstPageCommand}"
                          PreviousPageCommand="{Binding PreviousPageCommand}"
                          GoToPageCommand="{Binding GoToPageCommand}"
                          NextPageCommand="{Binding NextPageCommand}"
                          LastPageCommand="{Binding LastPageCommand}" />

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>