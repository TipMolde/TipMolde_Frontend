<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.AdicionarClientePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                Padding="24,18">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="16">

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="Adicionar cliente"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                    <Label Text="Cria um novo cliente e volta automaticamente para a lista."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28"
                                 Spacing="20">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                        StrokeThickness="1"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">
                        <Label Text="Dados do cliente"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nome"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Entry Text="{Binding Nome}"
                                   Placeholder="Nome do cliente"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="8">
                                <Label Text="NIF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding Nif}"
                                       Placeholder="123456789"
                                       Keyboard="Numeric"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8">
                                <Label Text="Sigla"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding Sigla}"
                                       Placeholder="Ex.: CV"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Pais"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Entry Text="{Binding Pais}"
                                   Placeholder="Pais do cliente"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Email"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Entry Text="{Binding Email}"
                                   Placeholder="cliente@empresa.pt"
                                   Keyboard="Email"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Telefone"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Entry Text="{Binding Telefone}"
                                   Placeholder="Contacto principal"
                                   Keyboard="Telephone"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                               FontSize="13" />

                        <ActivityIndicator IsRunning="{Binding IsSaving}"
                                           IsVisible="{Binding IsSaving}"
                                           HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="Auto,Auto"
                              ColumnSpacing="12">
                            <Button Text="Voltar"
                                    Command="{Binding VoltarCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    HeightRequest="44" />

                            <Button Grid.Column="1"
                                    Text="Criar cliente"
                                    Command="{Binding CreateCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
