<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.EditarClientePage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{StaticResource Surface}">

        <Border Grid.Row="0"
                BackgroundColor="White"
                Stroke="{StaticResource CardBorderBrush}"
                Padding="24,18">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="16">

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="Editar cliente"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Atualiza os dados do cliente e volta automaticamente para a lista."
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28"
                                 Spacing="20">
                <Border BackgroundColor="White"
                        Stroke="{StaticResource CardBorderBrush}"
                        StrokeThickness="1"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">
                        <Label Text="Dados do cliente"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="{StaticResource TextPrimary}" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nome"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Entry Text="{Binding Nome}"
                                   Placeholder="Nome do cliente"
                                   TextColor="{StaticResource TextPrimary}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <VerticalStackLayout Grid.Column="0"
                                                 Spacing="8">
                                <Label Text="NIF"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Entry Text="{Binding Nif}"
                                       Placeholder="123456789"
                                       Keyboard="Numeric"
                                       TextColor="{StaticResource TextPrimary}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8">
                                <Label Text="Sigla"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{StaticResource TextPrimary}" />
                                <Entry Text="{Binding Sigla}"
                                       Placeholder="Ex.: CV"
                                       TextColor="{StaticResource TextPrimary}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Pais"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Entry Text="{Binding Pais}"
                                   Placeholder="Pais do cliente"
                                   TextColor="{StaticResource TextPrimary}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Email"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Entry Text="{Binding Email}"
                                   Placeholder="cliente@empresa.pt"
                                   Keyboard="Email"
                                   TextColor="{StaticResource TextPrimary}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Telefone"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Entry Text="{Binding Telefone}"
                                   Placeholder="Contacto principal"
                                   Keyboard="Telephone"
                                   TextColor="{StaticResource TextPrimary}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="13" />

                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           HorizontalOptions="Center" />

                        <ActivityIndicator IsRunning="{Binding IsSaving}"
                                           IsVisible="{Binding IsSaving}"
                                           HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="Auto,Auto"
                              ColumnSpacing="12">
                            <Button Text="Voltar"
                                    Command="{Binding VoltarCommand}"
                                    BackgroundColor="#E2E8F0"
                                    TextColor="#0F172A"
                                    HeightRequest="44" />

                            <Button Grid.Column="1"
                                    Text="Guardar alteracoes"
                                    Command="{Binding SaveCommand}"
                                    BackgroundColor="#0F172A"
                                    TextColor="White"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
