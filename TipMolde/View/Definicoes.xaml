<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.Definicoes"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Definicoes" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{OnIdiom Phone='16', Desktop='28'}"
                                     Spacing="{OnIdiom Phone='16', Desktop='22'}">

                    <Border Background="{StaticResource BrandGradientBrush}"
                            StrokeThickness="0"
                            Padding="{OnIdiom Phone='18', Desktop='26'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>

                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="18">
                            <Border WidthRequest="72"
                                    HeightRequest="72"
                                    BackgroundColor="{AppThemeBinding Light=#ECFDF5, Dark=#0F3D38}"
                                    StrokeThickness="0"
                                    VerticalOptions="Start">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="36" />
                                </Border.StrokeShape>

                                <Label Text="{Binding UserInitials}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="26"
                                        TextColor="{AppThemeBinding Light={StaticResource BrandNavy}, Dark=#CCFBF1}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8">
                                <Label Text="Centro de conta"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='24', Desktop='32'}"
                                       TextColor="White" />

                                <Label Text="Consulta os dados da conta, atualiza credenciais e escolhe o tema visual da app."
                                       FontSize="{OnIdiom Phone='14', Desktop='15'}"
                                       TextColor="#E2E8F0"
                                       LineBreakMode="WordWrap" />

                                <FlexLayout Wrap="Wrap"
                                            Direction="Row"
                                            AlignItems="Start">
                                    <Border BackgroundColor="#0F172A"
                                            StrokeThickness="0"
                                            Padding="12,6"
                                            Margin="0,0,10,10">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="14" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding RoleDisplay}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13"
                                               TextColor="White" />
                                    </Border>
                                </FlexLayout>
                            </VerticalStackLayout>
                        </Grid>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HorizontalOptions="Center" />

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                           FontSize="13" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="{OnIdiom Phone='18', Desktop='22'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Dados da conta"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="22" />
                                    <Label Text="Edita o nome e o email associados ao utilizador autenticado."
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>

                                <Button Grid.Column="1"
                                        Text="Atualizar"
                                        Command="{Binding ReloadCommand}"
                                        BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                        TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                        HeightRequest="44"
                                        VerticalOptions="Start" />
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Nome"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" />
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                            StrokeThickness="1"
                                            Padding="14,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Entry Text="{Binding Nome}"
                                               Placeholder="Ex.: Goncalo Barroso" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="8">
                                    <Label Text="Email"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" />
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                            StrokeThickness="1"
                                            Padding="14,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Entry Text="{Binding Email}"
                                               Keyboard="Email"
                                               Placeholder="utilizador@tipmolde.pt" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Perfil"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" />
                                    <Border BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#1E293B}"
                                            StrokeThickness="0"
                                            Padding="14,12">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Label Text="{Binding RoleDisplay}"
                                               FontFamily="OpenSansSemibold"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="8">
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="Guardar alteracoes"
                                    Command="{Binding SaveProfileCommand}"
                                    HeightRequest="46" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="{OnIdiom Phone='18', Desktop='22'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="18">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Alterar password"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="22" />
                                <Label Text="A nova password deve ter pelo menos 8 caracteres, com maiuscula, minuscula, numero e simbolo."
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Password atual"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14" />
                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                        Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                        StrokeThickness="1"
                                        Padding="14,4">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="16" />
                                    </Border.StrokeShape>
                                    <Entry Text="{Binding CurrentPassword}"
                                           IsPassword="True"
                                           Placeholder="Introduz a password atual" />
                                </Border>
                            </VerticalStackLayout>

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="14">
                                <VerticalStackLayout Spacing="8">
                                    <Label Text="Nova password"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" />
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                            StrokeThickness="1"
                                            Padding="14,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Entry Text="{Binding NewPassword}"
                                               IsPassword="True"
                                               Placeholder="Ex.: NovaPass2026!" />
                                    </Border>
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="8">
                                    <Label Text="Confirmar nova password"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" />
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                            StrokeThickness="1"
                                            Padding="14,4">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="16" />
                                        </Border.StrokeShape>
                                        <Entry Text="{Binding ConfirmNewPassword}"
                                               IsPassword="True"
                                               Placeholder="Repete a nova password" />
                                    </Border>
                                </VerticalStackLayout>
                            </Grid>

                            <Button Text="Atualizar password"
                                    Command="{Binding ChangePasswordCommand}"
                                    HeightRequest="46" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="{OnIdiom Phone='18', Desktop='22'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="18">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Aparencia"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="22" />
                                <Label Text="Escolhe como queres ver a aplicacao neste dispositivo."
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="14,8">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Picker Title="Seleciona um tema"
                                        ItemsSource="{Binding ThemeOptions}"
                                        SelectedItem="{Binding SelectedThemeOption}" />
                            </Border>

                            <Border BackgroundColor="{AppThemeBinding Light=#EFF6FF, Dark=#172554}"
                                    StrokeThickness="0"
                                    Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label Text="{Binding SelectedThemeDescription}"
                                       TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#BFDBFE}" />
                            </Border>

                            <Button Text="Aplicar tema"
                                    Command="{Binding ApplyThemeCommand}"
                                    HeightRequest="46" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
