<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TipMolde.Models"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             x:Class="TipMolde.View.FilaTrabalhoPage"
             x:Name="PaginaFilaTrabalho"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0"
          BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Fila de Trabalho" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{StaticResource PageContentPadding}"
                                     Spacing="18">

                    <Grid ColumnDefinitions="Auto,*"
                          ColumnSpacing="12">
                        <Button Text="Voltar"
                                Command="{Binding VoltarCommand}"
                                BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                HeightRequest="44"
                                HorizontalOptions="Start" />

                        </Grid>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HorizontalOptions="Center" />

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                           FontSize="13" />

                    <CollectionView ItemsSource="{Binding Moldes}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                               ItemSpacing="16" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="30">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <Label Text="{Binding EmptyMessage}"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:FilaGlobalMoldeItemDto">
                                <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                        Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                        StrokeThickness="1"
                                        Padding="22"
                                        Margin="0,0,0,16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="24" />
                                    </Border.StrokeShape>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.AbrirMoldeCommand, Source={x:Reference PaginaFilaTrabalho}}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="14">
                                        <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                              ColumnSpacing="14">
                                            <Border BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                                    StrokeThickness="0"
                                                    Padding="12,8"
                                                    VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>

                                                <Label Text="{Binding Prioridade, StringFormat='Prioridade {0}'}"
                                                       FontFamily="OpenSansSemibold"
                                                       TextColor="{AppThemeBinding Light=#1D4ED8, Dark=#BFDBFE}" />
                                            </Border>

                                            <Border Grid.Column="1"
                                                    WidthRequest="64"
                                                    HeightRequest="64"
                                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                    StrokeThickness="1"
                                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                                    VerticalOptions="Center">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>

                                                <Image Source="{Binding ImagemCapaSource}"
                                                       Aspect="AspectFill"
                                                       WidthRequest="64"
                                                       HeightRequest="64" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="2"
                                                                 Spacing="4">
                                                <Label Text="{Binding NumeroMoldeDisplay}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="22"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                <Label Text="{Binding NomeMoldeDisplay}"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="3"
                                                    BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                    StrokeThickness="1"
                                                    Padding="12,8"
                                                    VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>

                                                <Label Text="{Binding DataEntregaPrevista, StringFormat='Entrega {0:dd/MM/yyyy}'}"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="18"
                                              RowSpacing="10">
                                            <VerticalStackLayout Grid.Row="0"
                                                                 Grid.Column="0"
                                                                 Spacing="4">
                                                <Label Text="Encomenda"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                <Label Text="{Binding NumeroEncomendaDisplay}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Row="0"
                                                                 Grid.Column="1"
                                                                 Spacing="4">
                                                <Label Text="Cliente"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                <Label Text="{Binding NomeClienteDisplay}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Row="1"
                                                                 Grid.Column="0"
                                                                 Spacing="4">
                                                <Label Text="Estado da encomenda"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                <Label Text="{Binding EstadoEncomendaDisplay}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Row="1"
                                                                 Grid.Column="1"
                                                                 Spacing="4">
                                                <Label Text="Quantidade"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                <Label Text="{Binding Quantidade}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <shared:PaginationBarView Page="{Binding Page}"
                                              TotalPages="{Binding TotalPages}"
                                              PageInput="{Binding PageInput}"
                                              CanGoFirst="{Binding CanGoFirst}"
                                              CanGoPrevious="{Binding CanGoPrevious}"
                                              CanGoNext="{Binding CanGoNext}"
                                              CanGoLast="{Binding CanGoLast}"
                                              FirstPageCommand="{Binding FirstPageCommand}"
                                              PreviousPageCommand="{Binding PreviousPageCommand}"
                                              GoToPageCommand="{Binding GoToPageCommand}"
                                              NextPageCommand="{Binding NextPageCommand}"
                                              LastPageCommand="{Binding LastPageCommand}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
