<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TipMolde.Models"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             x:Class="TipMolde.View.RegistoProducaoPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">
            <shared:TopBarView Grid.Row="0"
                               TitleText="{Binding PageTitle}" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="28,22,28,18"
                                     Spacing="18">

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="24">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">
                            <Button Text="Voltar"
                                    Command="{Binding VoltarCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    HorizontalOptions="Start"
                                    HeightRequest="42" />

                            <Label Text="{Binding IntroText}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <ActivityIndicator IsRunning="{Binding IsLoading}"
                                               IsVisible="{Binding IsLoading}"
                                               HorizontalOptions="Center" />

                            <Label Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding HasError}"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}" />
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="22">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">
                            <Label Text="Resumo da peca"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20" />

                            <Grid ColumnDefinitions="*,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="18"
                                  RowSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Molde"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding NumeroMoldeDisplay}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4">
                                    <Label Text="Nome do molde"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding NomeMoldeDisplay}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1"
                                                     Spacing="4">
                                    <Label Text="Peca"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding DesignacaoPecaDisplay}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Row="1"
                                                     Grid.Column="1"
                                                     Spacing="4">
                                    <Label Text="Numero da peca"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding NumeroPecaDisplay}" />
                                </VerticalStackLayout>
                                <VerticalStackLayout Grid.Row="2"
                                                     Grid.Column="1"
                                                     Spacing="4">
                                    <Label Text="Gestor de producao"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding GestorProducaoDisplay}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="22">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="14">
                            <Label Text="Estado atual"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20" />

                            <Grid ColumnDefinitions="*,*"
                                  ColumnSpacing="18">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Fase atual"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding FaseAtualDisplay}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                                     Spacing="4">
                                    <Label Text="Estado atual"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding EstadoAtualDisplay}" />
                                </VerticalStackLayout>
                            </Grid>

                            <VerticalStackLayout Spacing="4">
                                <Label Text="Proxima fase planeada"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13" />
                                <Label Text="{Binding ProximaFasePlaneadaDisplay}" />
                            </VerticalStackLayout>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="22">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">
                            <Label Text="Novo registo"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="20" />

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Fase"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13" />
                                <Picker Title="Selecionar fase"
                                        ItemsSource="{Binding FasesDisponiveis}"
                                        SelectedItem="{Binding SelectedFase, Mode=TwoWay}"
                                        IsEnabled="{Binding CanSelecionarFase}"
                                        ItemDisplayBinding="{Binding NomeDisplay}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Estado seguinte"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13" />
                                <Picker Title="Selecionar estado"
                                        ItemsSource="{Binding EstadosDisponiveis}"
                                        SelectedItem="{Binding SelectedEstado, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding DisplayName}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8">
                                <Label Text="Definir proxima fase"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13" />
                                <Picker Title="Selecionar proxima fase"
                                        ItemsSource="{Binding ProximasFasesDisponiveis}"
                                        SelectedItem="{Binding SelectedProximaFase, Mode=TwoWay}"
                                        ItemDisplayBinding="{Binding NomeDisplay}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="8"
                                                 IsVisible="{Binding IsMachineSelectionVisible}">
                                <Label Text="Maquina"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="13" />
                                <Picker Title="Selecionar maquina"
                                        ItemsSource="{Binding MaquinasDisponiveis}"
                                        SelectedItem="{Binding SelectedMaquina, Mode=TwoWay}"
                                        IsEnabled="{Binding CanSelecionarMaquina}"
                                        ItemDisplayBinding="{Binding DisplayName}" />
                            </VerticalStackLayout>

                            <Label Text="{Binding MachineHint}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <Button Text="{Binding SaveButtonText}"
                                    Command="{Binding GuardarCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                    HeightRequest="46" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
