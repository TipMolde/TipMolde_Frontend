<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             xmlns:viewmodel="clr-namespace:TipMolde.ViewModel"
             x:Class="TipMolde.View.MainPage">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">
        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Dashboard" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{OnIdiom Phone='16', Desktop='28'}"
                                     Spacing="{OnIdiom Phone='16', Desktop='24'}">

                    <Border Background="{StaticResource BrandGradientBrush}"
                            StrokeThickness="0"
                            Padding="{OnIdiom Phone='18', Desktop='34'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="{OnIdiom Phone='16', Desktop='20'}">
                            <Label Text="Dashboard do molde mais proximo de entrega"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="{OnIdiom Phone='24', Desktop='34'}"
                                   TextColor="White"
                                   LineBreakMode="WordWrap" />

                            <Label Text="Resumo visual do ciclo de vida, cliente e data prevista de entrega."
                                   FontSize="{OnIdiom Phone='14', Desktop='16'}"
                                   TextColor="#E2E8F0"
                                   LineBreakMode="WordWrap" />

                            <Button Text="Abrir detalhe do molde"
                                    Command="{Binding AbrirDashboardMoldeCommand}"
                                    IsEnabled="{Binding HasMoldeEntregaDashboard}"
                                    HorizontalOptions="Start" />

                            <Border Background="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                    StrokeThickness="0"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>

                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="14">
                                    <ActivityIndicator IsRunning="{Binding IsLoadingHero}"
                                                       IsVisible="{Binding IsLoadingHero}"
                                                       HorizontalOptions="Center" />

                                    <VerticalStackLayout Grid.Row="1"
                                                         Spacing="16"
                                                         IsVisible="{Binding HasMoldeEntregaDashboard}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="14">
                                            <VerticalStackLayout Spacing="8">
                                                <Label Text="{Binding NomeMoldeMaisProximoDisplay}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="{OnIdiom Phone='18', Desktop='24'}"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                                                <Label Text="{Binding NumeroMoldeMaisProximoDisplay, StringFormat='Molde: {0}'}"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                                <Label Text="{Binding ClienteMoldeMaisProximoDisplay, StringFormat='Cliente: {0}'}"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                                <Label Text="{Binding DataEntregaMoldeMaisProximoDisplay, StringFormat='Entrega prevista: {0}'}"
                                                       FontSize="14"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="1"
                                                    Background="{AppThemeBinding Light=#ECFDF5, Dark=#0F3D38}"
                                                    StrokeThickness="0"
                                                    Padding="14,10"
                                                    VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18" />
                                                </Border.StrokeShape>

                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="Conclusao"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="12"
                                                           TextColor="{StaticResource BrandGreenDark}" />
                                                    <Label Text="{Binding PercentagemConclusaoMaisProximoDisplay}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="18"
                                                           TextColor="{StaticResource BrandGreenDark}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <FlexLayout Wrap="Wrap"
                                                    Direction="Row"
                                                    JustifyContent="Start"
                                                    AlignItems="Start">
                                            <VerticalStackLayout Spacing="10"
                                                                 Margin="0,0,16,0">
                                                <shared:CicloVidaPieChartView HorizontalOptions="Center"
                                                                              TotalPecas="{Binding DashboardMaisProximo.TotalPecas}"
                                                                              Maquinacao="{Binding DashboardMaisProximo.Maquinacao}"
                                                                              Erosao="{Binding DashboardMaisProximo.Erosao}"
                                                                              Montagem="{Binding DashboardMaisProximo.Montagem}"
                                                                              MaterialPendente="{Binding DashboardMaisProximo.MaterialPendente}"
                                                                              EmEspera="{Binding DashboardMaisProximo.EmEspera}" />

                                                <Label Text="{Binding DashboardMaisProximo.TotalPecas, StringFormat='Total de pecas: {0}'}"
                                                       HorizontalOptions="Center"
                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                                       FontSize="13" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Spacing="12"
                                                                 MaximumWidthRequest="{OnIdiom Phone='360', Desktop='320'}">
                                                <Border Background="{AppThemeBinding Light=#EFF6FF, Dark=#172554}"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#2563EB"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Maquinacao"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DashboardMaisProximo.Maquinacao, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>

                                                <Border Background="{AppThemeBinding Light=#FFF7ED, Dark=#431407}"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#F97316"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Erosao"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DashboardMaisProximo.Erosao, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>

                                                <Border Background="{AppThemeBinding Light=#F0FDF4, Dark=#052E16}"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#16A34A"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Montagem"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DashboardMaisProximo.Montagem, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>

                                                <Border Background="{AppThemeBinding Light=#FFFBEB, Dark=#422006}"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#EAB308"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Material pendente"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DashboardMaisProximo.MaterialPendente, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>

                                                <Border Background="{AppThemeBinding Light=#F1F5F9, Dark=#0F172A}"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#64748B"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Em espera"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DashboardMaisProximo.EmEspera, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </VerticalStackLayout>
                                        </FlexLayout>
                                    </VerticalStackLayout>

                                    <Label Grid.Row="2"
                                           Text="{Binding HeroErrorMessage}"
                                           IsVisible="{Binding HasHeroError}"
                                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                                           FontSize="13" />

                                    <Label Grid.Row="2"
                                           Text="Sem dados suficientes para apresentar o molde mais proximo de entrega."
                                           IsVisible="{Binding HasNoMoldeEntregaDashboard}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                           FontSize="13" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start">

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                MinimumWidthRequest="{OnIdiom Phone='150', Desktop='220'}"
                                MaximumWidthRequest="{OnIdiom Phone='260', Desktop='280'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Moldes por Entregar"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="{Binding TotalMoldesPorEntregarDisplay}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Associados a encomendas ainda nao concluidas"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                MinimumWidthRequest="{OnIdiom Phone='150', Desktop='220'}"
                                MaximumWidthRequest="{OnIdiom Phone='260', Desktop='280'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Taxa de Conclusao"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="{Binding TaxaConclusaoDisplay}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Todas as Encomendas entrgues"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                MinimumWidthRequest="{OnIdiom Phone='150', Desktop='220'}"
                                MaximumWidthRequest="{OnIdiom Phone='260', Desktop='280'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Concluidos"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="{Binding EncomendasConcluidasUltimosTresMesesDisplay}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="{Binding IntervaloUltimosTresMesesDisplay, StringFormat='Concluidas registadas entre {0}'}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                MinimumWidthRequest="{OnIdiom Phone='150', Desktop='220'}"
                                MaximumWidthRequest="{OnIdiom Phone='260', Desktop='280'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Com Atraso"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="{Binding MoldesComAtrasoDisplay}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Moldes cuja data prevista de entrega ja foi ultrapassada"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="18"
                                         IsVisible="{Binding CanUseRececaoMaterial}">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="22">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="16">
                                <Label Text="Registo de chegada de material"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='22', Desktop='26'}" />
                                <Label Text="Seleciona o molde, marca as pecas que chegaram e deixa-as prontas para entrar em trabalho."
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                <Label Text="Sem moldes em producao disponiveis para registar rececoes."
                                       IsVisible="{Binding HasNoMoldesRececaoDisponiveis}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                <VerticalStackLayout Spacing="8"
                                                     IsVisible="{Binding HasMoldesRececaoDisponiveis}">
                                    <Label Text="Molde"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    <Picker Title="Selecionar molde"
                                            ItemsSource="{Binding MoldesRececaoDisponiveis}"
                                            SelectedItem="{Binding SelectedMoldeRececao, Mode=TwoWay}"
                                            ItemDisplayBinding="{Binding DisplayName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    <Label Text="{Binding SelectedMoldeRececaoResumo}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>

                                <ActivityIndicator IsRunning="{Binding IsLoadingRececaoMaterial}"
                                                   IsVisible="{Binding IsLoadingRececaoMaterial}"
                                                   HorizontalOptions="Center" />

                                <Label Text="{Binding RececaoMaterialErrorMessage}"
                                       IsVisible="{Binding HasRececaoMaterialError}"
                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                                       FontSize="13" />

                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                        Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                        StrokeThickness="1"
                                        Padding="16"
                                        IsVisible="{Binding HasSelectedMoldeRececao}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="12">
                                        <Label Text="Pecas pendentes para este molde"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                                        <Label Text="{Binding PecasRececaoSelectionSummary}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                        <CollectionView ItemsSource="{Binding PecasPendentesRececao}"
                                                        SelectionMode="None"
                                                        HeightRequest="280"
                                                        IsVisible="{Binding HasPecasPendentesRececao}">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical"
                                                                   ItemSpacing="10" />
                                            </CollectionView.ItemsLayout>

                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodel:SelectablePecaRececaoItem">
                                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1"
                                                            Padding="14">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16" />
                                                        </Border.StrokeShape>

                                                        <Grid ColumnDefinitions="Auto,*"
                                                              ColumnSpacing="12">
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalOptions="Start" />

                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 Spacing="4">
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      ColumnSpacing="10">
                                                                    <VerticalStackLayout Spacing="2">
                                                                        <Label Text="{Binding DesignacaoDisplay}"
                                                                               FontFamily="OpenSansSemibold"
                                                                               FontSize="14"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                                        <Label Text="{Binding NumeroPecaDisplay, StringFormat='Numero: {0}'}"
                                                                               FontSize="12"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                                    </VerticalStackLayout>

                                                                    <Border Grid.Column="1"
                                                                            Background="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                                                            StrokeThickness="0"
                                                                            Padding="10,6"
                                                                            VerticalOptions="Start">
                                                                        <Border.StrokeShape>
                                                                            <RoundRectangle CornerRadius="12" />
                                                                        </Border.StrokeShape>
                                                                        <Label Text="{Binding PrioridadeDisplay}"
                                                                               FontSize="11"
                                                                               FontFamily="OpenSansSemibold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource Info}, Dark=#BFDBFE}" />
                                                                    </Border>
                                                                </Grid>

                                                                <Label Text="{Binding MaterialDisplay, StringFormat='Material: {0}'}"
                                                                       FontSize="12"
                                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                                <Label Text="{Binding QuantidadeDisplay}"
                                                                       FontSize="12"
                                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <Label Text="Todas as pecas deste molde ja tem o material recebido."
                                               IsVisible="{Binding HasNoPecasPendentesRececao}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                        <Button Text="{Binding RececaoMaterialButtonText}"
                                                Command="{Binding RegistarChegadaMaterialCommand}"
                                                IsEnabled="{Binding CanRegistarChegadaMaterial}"
                                                HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
