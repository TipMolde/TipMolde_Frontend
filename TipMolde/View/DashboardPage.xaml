<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             x:Class="TipMolde.View.MainPage">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">
        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource Surface}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Dashboard" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{OnIdiom Phone='16', Desktop='28'}"
                                     Spacing="{OnIdiom Phone='16', Desktop='24'}">

                    <Border Background="{StaticResource BrandGradientBrush}"
                            StrokeThickness="0"
                            Padding="{OnIdiom Phone='18', Desktop='34'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="{OnIdiom Phone='16', Desktop='20'}">
                            <Label Text="Dashboard do molde mais proximo de entrega"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="{OnIdiom Phone='24', Desktop='34'}"
                                   TextColor="White"
                                   LineBreakMode="WordWrap" />

                            <Label Text="Resumo visual do ciclo de vida, cliente e data prevista de entrega."
                                   FontSize="{OnIdiom Phone='14', Desktop='16'}"
                                   TextColor="#E2E8F0"
                                   LineBreakMode="WordWrap" />

                            <Button Text="Abrir detalhe do molde"
                                    Command="{Binding AbrirDashboardMoldeCommand}"
                                    IsEnabled="{Binding HasMoldeEntregaDashboard}"
                                    WidthRequest="{OnIdiom Phone='190', Desktop='230'}"
                                    HorizontalOptions="Start" />

                            <Border Background="#F8FAFC"
                                    StrokeThickness="0"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>

                                <Grid RowDefinitions="Auto,Auto,Auto"
                                      RowSpacing="14">
                                    <ActivityIndicator IsRunning="{Binding IsLoadingHero}"
                                                       IsVisible="{Binding IsLoadingHero}"
                                                       HorizontalOptions="Center" />

                                    <VerticalStackLayout Grid.Row="1"
                                                         Spacing="16"
                                                         IsVisible="{Binding HasMoldeEntregaDashboard}">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="14">
                                            <VerticalStackLayout Spacing="8">
                                                <Label Text="{Binding NomeMoldeMaisProximoDisplay}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="{OnIdiom Phone='18', Desktop='24'}"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <Label Text="{Binding NumeroMoldeMaisProximoDisplay, StringFormat='Molde: {0}'}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource TextSecondary}" />

                                                <Label Text="{Binding ClienteMoldeMaisProximoDisplay, StringFormat='Cliente: {0}'}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource TextSecondary}" />

                                                <Label Text="{Binding DataEntregaMoldeMaisProximoDisplay, StringFormat='Entrega prevista: {0}'}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="1"
                                                    Background="#ECFDF5"
                                                    StrokeThickness="0"
                                                    Padding="14,10"
                                                    VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18" />
                                                </Border.StrokeShape>

                                                <VerticalStackLayout Spacing="2">
                                                    <Label Text="Conclusao"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="12"
                                                           TextColor="{StaticResource BrandGreenDark}" />
                                                    <Label Text="{Binding PercentagemConclusaoMaisProximoDisplay}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="18"
                                                           TextColor="{StaticResource BrandGreenDark}" />
                                                </VerticalStackLayout>
                                            </Border>
                                        </Grid>

                                        <FlexLayout Wrap="Wrap"
                                                    Direction="Row"
                                                    JustifyContent="Start"
                                                    AlignItems="Start">
                                            <VerticalStackLayout Spacing="10"
                                                                 Margin="0,0,16,0">
                                                <shared:CicloVidaPieChartView HorizontalOptions="Center"
                                                                              TotalPecas="{Binding DashboardMaisProximo.TotalPecas}"
                                                                              Maquinacao="{Binding DashboardMaisProximo.Maquinacao}"
                                                                              Erosao="{Binding DashboardMaisProximo.Erosao}"
                                                                              Montagem="{Binding DashboardMaisProximo.Montagem}"
                                                                              MaterialPendente="{Binding DashboardMaisProximo.MaterialPendente}" />

                                                <Label Text="{Binding DashboardMaisProximo.TotalPecas, StringFormat='Total de pecas: {0}'}"
                                                       HorizontalOptions="Center"
                                                       TextColor="{StaticResource TextSecondary}"
                                                       FontSize="13" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Spacing="12"
                                                                 WidthRequest="{OnIdiom Phone='260', Desktop='320'}">
                                                <Border Background="#EFF6FF"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#2563EB"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Maquinacao"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{StaticResource TextPrimary}" />
                                                            <Label Text="{Binding DashboardMaisProximo.Maquinacao, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{StaticResource TextSecondary}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>

                                                <Border Background="#FFF7ED"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#F97316"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Erosao"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{StaticResource TextPrimary}" />
                                                            <Label Text="{Binding DashboardMaisProximo.Erosao, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{StaticResource TextSecondary}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>

                                                <Border Background="#F0FDF4"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#16A34A"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Montagem"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{StaticResource TextPrimary}" />
                                                            <Label Text="{Binding DashboardMaisProximo.Montagem, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{StaticResource TextSecondary}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>

                                                <Border Background="#FFFBEB"
                                                        StrokeThickness="0"
                                                        Padding="14">
                                                    <Border.StrokeShape>
                                                        <RoundRectangle CornerRadius="18" />
                                                    </Border.StrokeShape>

                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="14"
                                                                HeightRequest="14"
                                                                BackgroundColor="#EAB308"
                                                                StrokeThickness="0"
                                                                VerticalOptions="Center">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="7" />
                                                            </Border.StrokeShape>
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="Material pendente"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="13"
                                                                   TextColor="{StaticResource TextPrimary}" />
                                                            <Label Text="{Binding DashboardMaisProximo.MaterialPendente, StringFormat='{}{0} pecas'}"
                                                                   TextColor="{StaticResource TextSecondary}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </Border>
                                            </VerticalStackLayout>
                                        </FlexLayout>
                                    </VerticalStackLayout>

                                    <Label Grid.Row="2"
                                           Text="{Binding HeroErrorMessage}"
                                           IsVisible="{Binding HasHeroError}"
                                           TextColor="{StaticResource Danger}"
                                           FontSize="13" />

                                    <Label Grid.Row="2"
                                           Text="Sem dados suficientes para apresentar o molde mais proximo de entrega."
                                           IsVisible="{Binding HasNoMoldeEntregaDashboard}"
                                           TextColor="{StaticResource TextSecondary}"
                                           FontSize="13" />
                                </Grid>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start">

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='160', Desktop='240'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Moldes Ativos"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="5"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Em producao neste momento"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='160', Desktop='240'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Taxa de Conclusao"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="64.2%"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Media geral dos projetos"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='160', Desktop='240'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Concluidos"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="12"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Projetos fechados este trimestre"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='160', Desktop='240'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Com Atraso"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="1"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Precisa de atencao esta semana"
                                       FontSize="13"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Ecraos principais"
                               FontFamily="OpenSansSemibold"
                               FontSize="{OnIdiom Phone='22', Desktop='28'}"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Previews reutilizaveis para cards, login, splash e outras seccoes da aplicacao."
                               FontSize="15"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start">

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='320', Desktop='320'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="dashboard_preview.svg"
                                       HeightRequest="{OnIdiom Phone='130', Desktop='170'}"
                                       Aspect="AspectFit" />
                                <Label Text="Dashboard executivo"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="20" />
                                <Label Text="Cards de KPI, progresso e estrutura limpa para demo em reuniao."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='320', Desktop='320'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="clients_preview.svg"
                                       HeightRequest="{OnIdiom Phone='130', Desktop='170'}"
                                       Aspect="AspectFit" />
                                <Label Text="Gestao de clientes"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="20" />
                                <Label Text="Cartoes bem definidos para contactos, empresas e acoes rapidas."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='320', Desktop='320'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="production_preview.svg"
                                       HeightRequest="{OnIdiom Phone='130', Desktop='170'}"
                                       Aspect="AspectFit" />
                                <Label Text="Producao em curso"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="20" />
                                <Label Text="Barras de estado e foco visual nas prioridades do chao de fabrica."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="18">
                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="22">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Pipeline de projeto"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='22', Desktop='26'}" />
                                <Label Text="Uma seccao pronta para mostrar progresso real ou dados demonstrativos."
                                       FontSize="15"
                                       TextColor="{StaticResource TextSecondary}" />

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Tampa Producao P12"
                                               FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.84"
                                                     HeightRequest="10" />
                                        <Label Text="84% concluido"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            Background="#ECFDF5"
                                            StrokeThickness="0"
                                            Padding="10,6"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Em curso"
                                               TextColor="{StaticResource BrandGreenDark}"
                                               FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Conector Automovel A7"
                                               FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.62"
                                                     HeightRequest="10" />
                                        <Label Text="62% concluido"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            Background="#FEF3C7"
                                            StrokeThickness="0"
                                            Padding="10,6"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Atencao"
                                               TextColor="{StaticResource Warning}"
                                               FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Carcaca Filtro B9"
                                               FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.95"
                                                     HeightRequest="10" />
                                        <Label Text="95% concluido"
                                               FontSize="12"
                                               TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1"
                                            Background="#DBEAFE"
                                            StrokeThickness="0"
                                            Padding="10,6"
                                            VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Validacao"
                                               TextColor="{StaticResource Info}"
                                               FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
