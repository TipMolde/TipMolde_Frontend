<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TipMolde.Models"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             x:Class="TipMolde.View.Encomendas"
             x:Name="PaginaEncomendas"
             BackgroundColor="{StaticResource Surface}">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource Surface}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Encomendas em Execucao" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="28,22,28,18"
                                     Spacing="18">

                    
                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HorizontalOptions="Center" />

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{StaticResource Danger}"
                           FontSize="13" />

                    <CollectionView ItemsSource="{Binding Encomendas}"
                                    SelectionMode="None">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical"
                                               ItemSpacing="16" />
                        </CollectionView.ItemsLayout>

                        <CollectionView.EmptyView>
                            <Border BackgroundColor="White"
                                    Stroke="{StaticResource CardBorderBrush}"
                                    StrokeThickness="1"
                                    Padding="30">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <Label Text="{Binding EmptyMessage}"
                                       HorizontalOptions="Center"
                                       TextColor="{StaticResource TextSecondary}" />
                            </Border>
                        </CollectionView.EmptyView>

                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:EncomendaResumoDto">
                                <Border BackgroundColor="White"
                                        Stroke="{StaticResource CardBorderBrush}"
                                        StrokeThickness="1"
                                        Padding="22"
                                        Margin="0,0,0,16">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="24" />
                                    </Border.StrokeShape>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Command="{Binding BindingContext.AbrirEncomendaCommand, Source={x:Reference PaginaEncomendas}}"
                                                              CommandParameter="{Binding .}" />
                                    </Border.GestureRecognizers>

                                    <VerticalStackLayout Spacing="14">
                                        <Grid ColumnDefinitions="*,Auto"
                                              ColumnSpacing="16">
                                            <VerticalStackLayout Spacing="6">
                                                <Label Text="{Binding NumeroEncomendaClienteDisplay}"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="22"
                                                       TextColor="{StaticResource TextPrimary}" />

                                                <Label Text="{Binding NomeServicoClienteDisplay}"
                                                       FontSize="14"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>

                                            <Border Grid.Column="1"
                                                    Background="#DBEAFE"
                                                    StrokeThickness="0"
                                                    Padding="12,6"
                                                    VerticalOptions="Start">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="14" />
                                                </Border.StrokeShape>

                                                <Label Text="{Binding EstadoDisplay}"
                                                       FontSize="13"
                                                       TextColor="#1D4ED8" />
                                            </Border>
                                        </Grid>

                                        <Grid ColumnDefinitions="*,*"
                                              RowDefinitions="Auto,Auto"
                                              ColumnSpacing="18"
                                              RowSpacing="10">
                                            <VerticalStackLayout Grid.Row="0"
                                                                 Grid.Column="0"
                                                                 Spacing="4">
                                                <Label Text="Cliente"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding NomeClienteDisplay}"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Row="0"
                                                                 Grid.Column="1"
                                                                 Spacing="4">
                                                <Label Text="Projeto"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding NumeroProjetoClienteDisplay}"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Row="1"
                                                                 Grid.Column="0"
                                                                 Spacing="4">
                                                <Label Text="Responsavel"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding NomeResponsavelClienteDisplay}"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>

                                            <VerticalStackLayout Grid.Row="1"
                                                                 Grid.Column="1"
                                                                 Spacing="4">
                                                <Label Text="Data de registo"
                                                       FontFamily="OpenSansSemibold"
                                                       FontSize="13"
                                                       TextColor="{StaticResource TextPrimary}" />
                                                <Label Text="{Binding DataRegisto, StringFormat='{}{0:dd/MM/yyyy}'}"
                                                       TextColor="{StaticResource TextSecondary}" />
                                            </VerticalStackLayout>
                                        </Grid>

                                    </VerticalStackLayout>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <shared:PaginationBarView Page="{Binding Page}"
                                              TotalPages="{Binding TotalPages}"
                                              PageInput="{Binding PageInput}"
                                              CanGoFirst="{Binding CanGoFirst}"
                                              CanGoPrevious="{Binding CanGoPrevious}"
                                              CanGoNext="{Binding CanGoNext}"
                                              CanGoLast="{Binding CanGoLast}"
                                              FirstPageCommand="{Binding FirstPageCommand}"
                                              PreviousPageCommand="{Binding PreviousPageCommand}"
                                              GoToPageCommand="{Binding GoToPageCommand}"
                                              NextPageCommand="{Binding NextPageCommand}"
                                              LastPageCommand="{Binding LastPageCommand}" />
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
