<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.AutenticacaoPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">
        <ScrollView>
            <VerticalStackLayout Padding="24"
                                 Spacing="0">

                <Border HorizontalOptions="Center"
                        MaximumWidthRequest="1120"
                        BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                        StrokeThickness="1"
                        Padding="0">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="32" />
                    </Border.StrokeShape>

                    <Grid ColumnSpacing="0"
                          RowSpacing="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Row="0"
                                Background="{StaticResource BrandGradientBrush}"
                                StrokeThickness="0"
                                Padding="28">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="32,32,0,0" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="18">
                                <HorizontalStackLayout Spacing="12">
                                    <Grid WidthRequest="220"
                                        HeightRequest="70">
                                        <Grid.Clip>
                                            <RoundRectangleGeometry CornerRadius="13"
                                                Rect="0,0,220,70" />
                                        </Grid.Clip>
                                        <Image Source="tipmolde_header.jpg"
                                            Aspect="AspectFit" />
                                    </Grid>
                                </HorizontalStackLayout>

                                <Label Text="Inicie sessao e valide o acesso logo no arranque da aplicacao."
                                       FontFamily="OpenSansSemibold"
                                       FontSize="32"
                                       TextColor="White"
                                       LineBreakMode="WordWrap" />
                            </VerticalStackLayout>
                        </Border>

                        <Grid Grid.Row="1"
                              Padding="28"
                              ColumnSpacing="24"
                              RowSpacing="24">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Row="0"
                                    BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="24">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="28" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="18">
                                    <Border IsVisible="{Binding HasError}"
                                        BackgroundColor="{AppThemeBinding Light=#FEF2F2, Dark=#3F1014}"
                                        Stroke="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                                        StrokeThickness="1"
                                        Padding="16">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="22" />
                                        </Border.StrokeShape>
                                        <Border.Shadow>
                                            <Shadow Brush="#220F172A"
                                                Offset="0,8"
                                                Radius="18"
                                                Opacity="0.18" />
                                        </Border.Shadow>

                                        <Grid ColumnDefinitions="Auto,*"
                                                ColumnSpacing="12">
                                            <Border BackgroundColor="{AppThemeBinding Light=#FEE2E2, Dark=#5B1A1E}"
                                                StrokeThickness="0"
                                                WidthRequest="36"
                                                HeightRequest="36">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="18" />
                                                </Border.StrokeShape>
                                                <Label Text="!"
                                                   HorizontalOptions="Center"
                                                   VerticalOptions="Center"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="18"
                                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}" />
                                            </Border>

                                            <VerticalStackLayout Grid.Column="1"
                                                Spacing="4">
                                                <Label Text="{Binding ErrorTitle}"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="15"
                                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}" />
                                                <Label Text="{Binding ErrorMessage}"
                                                   FontSize="13"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                                   LineBreakMode="WordWrap" />
                                            </VerticalStackLayout>
                                        </Grid>
                                    </Border>

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Iniciar sessao"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="28"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Text="Introduza os seus dados para validar a ligacao."
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                           LineBreakMode="WordWrap" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Email ou utilizador"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" />
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#111827}"
                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                            StrokeThickness="1"
                                            Padding="16,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>
                                            <Entry x:Name="UtilizadorEntry"
                                               Placeholder="exemplo@tipmolde.pt"
                                               Text="{Binding Email}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                               ClearButtonVisibility="WhileEditing" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Palavra-passe"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" />
                                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#111827}"
                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                            StrokeThickness="1"
                                            Padding="16,8">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>
                                            <Entry x:Name="PasswordEntry"
                                               Placeholder="Introduza a sua palavra-passe"
                                               Text="{Binding Password}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                               PlaceholderColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                               IsPassword="True" />
                                        </Border>
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="Auto,*"
                                        ColumnSpacing="12">
                                        <CheckBox IsChecked="{Binding RememberSession}" />
                                        <Label Grid.Column="1"
                                           Text="Manter sessao iniciada neste dispositivo"
                                           VerticalTextAlignment="Center"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                    </Grid>

                                    <Button Text="Entrar"
                                        Command="{Binding LoginCommand}" />

                                    <ActivityIndicator IsVisible="{Binding IsBusy}"
                                       IsRunning="{Binding IsBusy}"
                                       HorizontalOptions="Center" />
                                </VerticalStackLayout>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
