<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TipMolde.ViewModel"
             x:Class="TipMolde.View.AdicionarEncomendaPage"
             x:Name="PaginaAdicionarEncomenda"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                Padding="24,18">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="16">

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="Adicionar encomenda"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                    <Label Text="Seleciona um cliente, escolhe os moldes e define a quantidade pedida de cada um."
                           FontSize="13"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28"
                                 Spacing="20">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                        StrokeThickness="1"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">
                        <Label Text="Dados da encomenda"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                        <ActivityIndicator IsRunning="{Binding IsLoadingData}"
                                           IsVisible="{Binding IsLoadingData}"
                                           HorizontalOptions="Center" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Numero da encomenda"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Entry Text="{Binding NumeroEncomendaCliente}"
                                   Placeholder="Numero da encomenda do cliente"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Numero do projeto"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Entry Text="{Binding NumeroProjetoCliente}"
                                   Placeholder="Projeto associado"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nome do servico"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Picker Title="Selecionar nome do servico"
                                    ItemsSource="{Binding NomeServicoOptions}"
                                    SelectedItem="{Binding SelectedNomeServicoOption, Mode=TwoWay}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Label Text="As opcoes seguem o enum TipoPedido do backend."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Responsavel"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Entry Text="{Binding NomeResponsavelCliente}"
                                   Placeholder="Responsavel do cliente"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Cliente"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                            <Picker Title="Selecionar cliente"
                                    ItemsSource="{Binding ClientesDisponiveis}"
                                    SelectedItem="{Binding SelectedClienteOption, Mode=TwoWay}"
                                    ItemDisplayBinding="{Binding DisplayName}"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                            <Label Text="{Binding SelectedClienteSummary}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="6">
                                    <Label Text="{Binding SelectedClienteOption.NomeDisplay, StringFormat='Nome: {0}'}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    <Label Text="{Binding SelectedClienteOption.SiglaDisplay, StringFormat='Sigla: {0}'}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                    <Label Text="{Binding SelectedClienteOption.NifDisplay, StringFormat='NIF: {0}'}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>
                            </Border>

                            <Label Text="A encomenda so pode ser criada com um unico cliente associado."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Moldes associados"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                            <SearchBar Placeholder="Pesquisar molde por nome, numero ou descricao"
                                       Text="{Binding MoldeSearchTerm}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                            <Label Text="{Binding SelectedMoldesSummary}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="14">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <CollectionView ItemsSource="{Binding MoldesVisiveis}"
                                                SelectionMode="None"
                                                HeightRequest="280">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical"
                                                           ItemSpacing="10" />
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.EmptyView>
                                        <Label Text="Nao existem moldes disponiveis para associar."
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                    </CollectionView.EmptyView>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:SelectableMoldeItem">
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                    StrokeThickness="1"
                                                    Padding="14">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>

                                                <Grid ColumnDefinitions="Auto,Auto,*"
                                                      ColumnSpacing="12">
                                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                              VerticalOptions="Start" />

                                                    <Border Grid.Column="1"
                                                            WidthRequest="54"
                                                            HeightRequest="54"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1"
                                                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="14" />
                                                        </Border.StrokeShape>

                                                        <Image Source="{Binding ImagemCapaSource}"
                                                               Aspect="AspectFill"
                                                               WidthRequest="54"
                                                               HeightRequest="54" />
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="2"
                                                                         Spacing="3">
                                                        <Label Text="{Binding NomeDisplay}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="14"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                        <Label Text="{Binding NumeroDisplay, StringFormat='Numero: {0}'}"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        <Label Text="{Binding DescricaoDisplay}"
                                                               FontSize="12"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                                               LineBreakMode="TailTruncation" />
                                                    </VerticalStackLayout>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>

                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">
                                <Button Text="Anterior"
                                        Command="{Binding PreviousMoldesPageCommand}"
                                        IsEnabled="{Binding CanGoPreviousMoldes}"
                                        BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                        TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                        HeightRequest="42" />

                                <Label Grid.Column="1"
                                       Text="{Binding MoldePage, StringFormat='Pagina {0}'}"
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                <Button Grid.Column="2"
                                        Text="Seguinte"
                                        Command="{Binding NextMoldesPageCommand}"
                                        IsEnabled="{Binding CanGoNextMoldes}"
                                        BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                        TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                        HeightRequest="42" />
                            </Grid>

                            <Label Text="{Binding MoldeTotalPages, StringFormat='Total de paginas de moldes: {0}'}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <Label Text="Seleciona pelo menos um molde para conseguires criar a encomenda."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="10">
                            <Label Text="Prioridade e entrega por molde"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                            <Label Text="Cada molde fica associado a esta encomenda com a sua quantidade pedida, data de entrega e prioridade global."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <ActivityIndicator IsRunning="{Binding IsCalculatingPriorities}"
                                               IsVisible="{Binding IsCalculatingPriorities}"
                                               HorizontalOptions="Center" />

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="14"
                                    IsVisible="{Binding HasSelectedMoldes}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <CollectionView ItemsSource="{Binding MoldesSelecionados}"
                                                SelectionMode="None"
                                                HeightRequest="260">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical"
                                                           ItemSpacing="10" />
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="viewmodel:SelectableMoldeItem">
                                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                    StrokeThickness="1"
                                                    Padding="14">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>

                                                <VerticalStackLayout Spacing="10">
                                                    <Grid ColumnDefinitions="Auto,*"
                                                          ColumnSpacing="12">
                                                        <Border WidthRequest="54"
                                                                HeightRequest="54"
                                                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                                StrokeThickness="1"
                                                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}">
                                                            <Border.StrokeShape>
                                                                <RoundRectangle CornerRadius="14" />
                                                            </Border.StrokeShape>

                                                            <Image Source="{Binding ImagemCapaSource}"
                                                                   Aspect="AspectFill"
                                                                   WidthRequest="54"
                                                                   HeightRequest="54" />
                                                        </Border>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="3">
                                                            <Label Text="{Binding NomeDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="14"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding NumeroDisplay, StringFormat='Numero: {0}'}"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Grid>

                                                    <Grid ColumnDefinitions="Auto,Auto,*"
                                                          ColumnSpacing="12">
                                                        <VerticalStackLayout Spacing="4">
                                                            <Label Text="Quantidade"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Entry Text="{Binding QuantidadePedida, Mode=TwoWay}"
                                                                   Keyboard="Numeric"
                                                                   WidthRequest="90"
                                                                   HorizontalTextAlignment="Center"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                        </VerticalStackLayout>

                                                        <VerticalStackLayout Grid.Column="1"
                                                                             Spacing="4">
                                                            <Label Text="Prioridade"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding Prioridade}"
                                                                   VerticalOptions="Center"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>

                                                        <VerticalStackLayout Grid.Column="2"
                                                                             Spacing="4">
                                                            <Label Text="Entrega prevista"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <DatePicker Date="{Binding DataEntregaPrevista, Mode=TwoWay}"
                                                                        Format="dd/MM/yyyy"
                                                                        TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                        </VerticalStackLayout>
                                                    </Grid>
                                                </VerticalStackLayout>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </Border>

                            <Label Text="Ainda nao existem moldes selecionados para configurar."
                                   IsVisible="{Binding HasNoSelectedMoldes}"
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <Label Text="Exemplo: podes pedir o mesmo molde mais do que uma vez nesta encomenda e definir a quantidade diretamente aqui."
                                   FontSize="12"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                               FontSize="13" />

                        <ActivityIndicator IsRunning="{Binding IsSaving}"
                                           IsVisible="{Binding IsSaving}"
                                           HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="Auto,Auto"
                              ColumnSpacing="12">
                            <Button Text="Voltar"
                                    Command="{Binding VoltarCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    HeightRequest="44" />

                            <Button Grid.Column="1"
                                    Text="Criar encomenda"
                                    Command="{Binding CreateCommand}"
                                    IsEnabled="{Binding CanCreate}"
                                    BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
