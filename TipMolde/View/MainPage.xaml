<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             x:Class="TipMolde.View.MainPage">

    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="0">
        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource Surface}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Dashboard"/>

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{OnIdiom Phone='16', Desktop='28'}"
                                     Spacing="{OnIdiom Phone='16', Desktop='24'}">

                    <Border Background="{StaticResource BrandGradientBrush}"
                            StrokeThickness="0"
                            Padding="{OnIdiom Phone='18', Desktop='34'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="30" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="{OnIdiom Phone='16', Desktop='20'}">
                            <Label Text="Dashboard do molde mais próximo de entrega"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="{OnIdiom Phone='24', Desktop='34'}"
                                   TextColor="White"
                                   LineBreakMode="WordWrap" />

                            <Label Text="Resumo visual da produção, estado do backend e indicadores principais."
                                   FontSize="{OnIdiom Phone='14', Desktop='16'}"
                                   TextColor="#E2E8F0"
                                   LineBreakMode="WordWrap" />

                            <Button Text="Apresentar dashboard"
                                    WidthRequest="{OnIdiom Phone='180', Desktop='220'}"
                                    HorizontalOptions="Start" />

                            <Border Background="#F8FAFC"
                                    StrokeThickness="0"
                                    Padding="16">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="26" />
                                </Border.StrokeShape>
                                <Image Source="dashboard_preview.svg"
                                       Aspect="AspectFit"
                                       HeightRequest="{OnIdiom Phone='180', Desktop='240'}" />
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start">

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='160', Desktop='240'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Moldes Ativos" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="5" FontFamily="OpenSansSemibold" FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Em produção neste momento" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='160', Desktop='240'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Taxa de Conclusão" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="64.2%" FontFamily="OpenSansSemibold" FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Média geral dos projetos" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='160', Desktop='240'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Concluídos" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="12" FontFamily="OpenSansSemibold" FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Projetos fechados este trimestre" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="20"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='160', Desktop='240'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Com Atraso" FontFamily="OpenSansSemibold" FontSize="18" />
                                <Label Text="1" FontFamily="OpenSansSemibold" FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Precisa de atenção esta semana" FontSize="13" TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="10">
                        <Label Text="Ecrãs principais"
                               FontFamily="OpenSansSemibold"
                               FontSize="{OnIdiom Phone='22', Desktop='28'}"
                               TextColor="{StaticResource TextPrimary}" />
                        <Label Text="Previews reutilizáveis para cards, login, splash e outras secções da aplicação."
                               FontSize="15"
                               TextColor="{StaticResource TextSecondary}" />
                    </VerticalStackLayout>

                    <FlexLayout Wrap="Wrap"
                                Direction="Row"
                                JustifyContent="Start"
                                AlignItems="Start">

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='320', Desktop='320'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="dashboard_preview.svg"
                                       HeightRequest="{OnIdiom Phone='130', Desktop='170'}"
                                       Aspect="AspectFit" />
                                <Label Text="Dashboard executivo" FontFamily="OpenSansSemibold" FontSize="20" />
                                <Label Text="Cards de KPI, progresso e estrutura limpa para demo em reunião."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='320', Desktop='320'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="clients_preview.svg"
                                       HeightRequest="{OnIdiom Phone='130', Desktop='170'}"
                                       Aspect="AspectFit" />
                                <Label Text="Gestão de clientes" FontFamily="OpenSansSemibold" FontSize="20" />
                                <Label Text="Cartões bem definidos para contactos, empresas e ações rápidas."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="18"
                                Margin="0,0,16,16"
                                WidthRequest="{OnIdiom Phone='320', Desktop='320'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="14">
                                <Image Source="production_preview.svg"
                                       HeightRequest="{OnIdiom Phone='130', Desktop='170'}"
                                       Aspect="AspectFit" />
                                <Label Text="Produção em curso" FontFamily="OpenSansSemibold" FontSize="20" />
                                <Label Text="Barras de estado e foco visual nas prioridades do chão de fábrica."
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                            </VerticalStackLayout>
                        </Border>
                    </FlexLayout>

                    <VerticalStackLayout Spacing="18">
                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="22">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="16">
                                <Label Text="Pipeline de projeto"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='22', Desktop='26'}" />
                                <Label Text="Uma secção pronta para mostrar progresso real ou dados demonstrativos."
                                       FontSize="15"
                                       TextColor="{StaticResource TextSecondary}" />

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Tampa Produção P12" FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.84" HeightRequest="10" />
                                        <Label Text="84% concluído" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Background="#ECFDF5" StrokeThickness="0" Padding="10,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Em curso" TextColor="{StaticResource BrandGreenDark}" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Conector Automóvel A7" FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.62" HeightRequest="10" />
                                        <Label Text="62% concluído" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Background="#FEF3C7" StrokeThickness="0" Padding="10,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Atenção" TextColor="{StaticResource Warning}" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <VerticalStackLayout Spacing="8">
                                        <Label Text="Molde Carcaça Filtro B9" FontFamily="OpenSansSemibold" />
                                        <ProgressBar Progress="0.95" HeightRequest="10" />
                                        <Label Text="95% concluído" FontSize="12" TextColor="{StaticResource TextSecondary}" />
                                    </VerticalStackLayout>
                                    <Border Grid.Column="1" Background="#DBEAFE" StrokeThickness="0" Padding="10,6" VerticalOptions="Center">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="12" />
                                        </Border.StrokeShape>
                                        <Label Text="Validação" TextColor="{StaticResource Info}" FontFamily="OpenSansSemibold" />
                                    </Border>
                                </Grid>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>