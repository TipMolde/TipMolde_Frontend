<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             xmlns:models="clr-namespace:TipMolde.Models"
             x:Class="TipMolde.View.Clientes"
             x:Name="PaginaClientes"
             BackgroundColor="{StaticResource Surface}">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{StaticResource Surface}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Gestao de Clientes" />

            <CollectionView Grid.Row="1"
                            ItemsSource="{Binding Clientes}"
                            SelectionMode="None"
                            Margin="28,22,28,18">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Vertical"
                                       ItemSpacing="16" />
                </CollectionView.ItemsLayout>

                <CollectionView.Header>
                    <VerticalStackLayout Spacing="18">
                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="24">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="28" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="16">
                                <Label Text="Pesquisar clientes"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18"
                                       TextColor="{StaticResource TextPrimary}" />

                                <Grid ColumnDefinitions="160,*,Auto,Auto"
                                      ColumnSpacing="12">

                                    <Picker Grid.Column="0"
                                            Title="Pesquisar por"
                                            TextColor="{StaticResource TextPrimary}"
                                            ItemsSource="{Binding SearchModes}"
                                            SelectedIndex="{Binding SelectedSearchModeIndex}"
                                            />

                                    <SearchBar Grid.Column="1"
                                               Placeholder="Escreve o nome ou a sigla"
                                               Text="{Binding SearchTerm}"
                                               TextColor="{StaticResource TextPrimary}"
                                               SearchCommand="{Binding PesquisarCommand}" />

                                    <Button Grid.Column="2"
                                            Text="Pesquisar"
                                            Command="{Binding PesquisarCommand}"
                                            BackgroundColor="#0F172A"
                                            TextColor="White"
                                            HeightRequest="44" />

                                    <Button Grid.Column="3"
                                            Text="Limpar"
                                            Command="{Binding LimparPesquisaCommand}"
                                            IsEnabled="{Binding HasSearch}"
                                            BackgroundColor="#E2E8F0"
                                            TextColor="#0F172A"
                                            HeightRequest="44" />
                                </Grid>

                                <Label Text="{Binding ErrorMessage}"
                                       IsVisible="{Binding HasError}"
                                       TextColor="{StaticResource Danger}"
                                       FontSize="13" />
                            </VerticalStackLayout>
                        </Border>

                        <ActivityIndicator IsRunning="{Binding IsLoading}"
                                           IsVisible="{Binding IsLoading}"
                                           HorizontalOptions="Center" />

                        <Button Text="Adicionar cliente"
                                Command="{Binding AbrirAdicionarClienteCommand}"
                                BackgroundColor="#0F172A"
                                TextColor="White"
                                HeightRequest="44" />
                    </VerticalStackLayout>
                </CollectionView.Header>

                <CollectionView.EmptyView>
                    <Border BackgroundColor="White"
                            Stroke="{StaticResource CardBorderBrush}"
                            StrokeThickness="1"
                            Padding="30">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <Label Text="Nao existem clientes para apresentar."
                               HorizontalOptions="Center"
                               TextColor="{StaticResource TextSecondary}" />
                    </Border>
                </CollectionView.EmptyView>

                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:ClienteDto">
                        <Border BackgroundColor="White"
                                Stroke="{StaticResource CardBorderBrush}"
                                StrokeThickness="1"
                                Padding="22"
                                Margin="0,0,0,16">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>

                            <Border.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding Source={x:Reference PaginaClientes}, Path=BindingContext.AbrirDetalheClienteCommand}"
                                      CommandParameter="{Binding .}" />
                            </Border.GestureRecognizers>

                            <Grid ColumnDefinitions="2.2*,1.4*"
                                ColumnSpacing="18">

                                <VerticalStackLayout Spacing="8">
                                    <Label Text="{Binding Nome}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="22"
                                       TextColor="{StaticResource TextPrimary}" />

                                    <Label Text="{Binding Sigla, StringFormat='Sigla: {0}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />

                                    <Label Text="{Binding NIF, StringFormat='NIF: {0}'}"
                                       FontSize="14"
                                       TextColor="{StaticResource TextSecondary}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="1"
                                     Spacing="10"
                                     VerticalOptions="Center">
                                    <Button Text="Editar Cliente"
                                        Command="{Binding BindingContext.EditarClienteCommand, Source={x:Reference PaginaClientes}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="#E2E8F0"
                                        TextColor="#0F172A"
                                        CornerRadius="16"
                                        HeightRequest="44" />

                                    <Button Text="Apagar Cliente"
                                        Command="{Binding BindingContext.DeleteCommand, Source={x:Reference PaginaClientes}}"
                                        CommandParameter="{Binding .}"
                                        BackgroundColor="Red"
                                        TextColor="White"
                                        CornerRadius="16"
                                        HeightRequest="44" />
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>

                <CollectionView.Footer>
                    <shared:PaginationBarView Page="{Binding Page}"
                          TotalPages="{Binding TotalPages}"
                          PageInput="{Binding PageInput}"
                          CanGoFirst="{Binding CanGoFirst}"
                          CanGoPrevious="{Binding CanGoPrevious}"
                          CanGoNext="{Binding CanGoNext}"
                          CanGoLast="{Binding CanGoLast}"
                          FirstPageCommand="{Binding FirstPageCommand}"
                          PreviousPageCommand="{Binding PreviousPageCommand}"
                          GoToPageCommand="{Binding GoToPageCommand}"
                          NextPageCommand="{Binding NextPageCommand}"
                          LastPageCommand="{Binding LastPageCommand}" />
                </CollectionView.Footer>
            </CollectionView>
        </Grid>
    </Grid>
</ContentPage>
