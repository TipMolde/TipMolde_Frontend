                                           IsVisible="{Binding HasNoMoldeEntregaDashboard}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                           FontSize="13" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Border>

                    <Grid ColumnDefinitions="*,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          ColumnSpacing="16"
                          RowSpacing="16">

                        <Border Grid.Column="0"
                                Grid.Row="0"
                                Grid.ColumnSpan="{Binding SummaryCardColumnSpan, Source={x:Reference PaginaDashboard}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20"
                                MinimumWidthRequest="{OnIdiom Phone='150', Desktop='220'}"
                                MaximumWidthRequest="{OnIdiom Phone='260', Desktop='280'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Moldes por Entregar"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="{Binding TotalMoldesPorEntregarDisplay}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Associados a encomendas ainda nao concluidas"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="{Binding SummarySecondColumn, Source={x:Reference PaginaDashboard}}"
                                Grid.Row="{Binding SummarySecondRow, Source={x:Reference PaginaDashboard}}"
                                Grid.ColumnSpan="{Binding SummaryCardColumnSpan, Source={x:Reference PaginaDashboard}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20"
                                MinimumWidthRequest="{OnIdiom Phone='150', Desktop='220'}"
                                MaximumWidthRequest="{OnIdiom Phone='260', Desktop='280'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Taxa de Conclusao"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="{Binding TaxaConclusaoDisplay}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Todas as Encomendas entrgues"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="{Binding SummaryThirdColumn, Source={x:Reference PaginaDashboard}}"
                                Grid.Row="{Binding SummaryThirdRow, Source={x:Reference PaginaDashboard}}"
                                Grid.ColumnSpan="{Binding SummaryCardColumnSpan, Source={x:Reference PaginaDashboard}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20"
                                MinimumWidthRequest="{OnIdiom Phone='150', Desktop='220'}"
                                MaximumWidthRequest="{OnIdiom Phone='260', Desktop='280'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Concluidos"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="{Binding EncomendasConcluidasUltimosTresMesesDisplay}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="{Binding IntervaloUltimosTresMesesDisplay, StringFormat='Concluidas registadas entre {0}'}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>

                        <Border Grid.Column="{Binding SummaryFourthColumn, Source={x:Reference PaginaDashboard}}"
                                Grid.Row="{Binding SummaryFourthRow, Source={x:Reference PaginaDashboard}}"
                                Grid.ColumnSpan="{Binding SummaryCardColumnSpan, Source={x:Reference PaginaDashboard}}"
                                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20"
                                MinimumWidthRequest="{OnIdiom Phone='150', Desktop='220'}"
                                MaximumWidthRequest="{OnIdiom Phone='260', Desktop='280'}">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>
                            <VerticalStackLayout Spacing="10">
                                <Label Text="Com Atraso"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18" />
                                <Label Text="{Binding MoldesComAtrasoDisplay}"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='30', Desktop='38'}" />
                                <Label Text="Moldes cuja data prevista de entrega ja foi ultrapassada"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>
                        </Border>
                    </Grid>

                    <VerticalStackLayout Spacing="14"
                                         IsVisible="{Binding CanUseRececaoMaterial}">
                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="22">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="26" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="16">
                                <Label Text="Registo de chegada de material"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="{OnIdiom Phone='22', Desktop='26'}" />
                                <Label Text="Seleciona o molde, marca as pecas que chegaram e deixa-as prontas para entrar em trabalho."
                                       FontSize="15"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                <Label Text="Sem moldes com pedido de material ativo disponiveis para registar rececoes."
                                       IsVisible="{Binding HasNoMoldesRececaoDisponiveis}"
                                       FontSize="13"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                <VerticalStackLayout Spacing="8"
                                                     IsVisible="{Binding HasMoldesRececaoDisponiveis}">
                                    <Label Text="Molde"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    <Picker Title="Selecionar molde"
                                            ItemsSource="{Binding MoldesRececaoDisponiveis}"
                                            SelectedItem="{Binding SelectedMoldeRececao, Mode=TwoWay}"
                                            ItemDisplayBinding="{Binding DisplayName}"
                                            TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    <Label Text="{Binding SelectedMoldeRececaoResumo}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>

                                <ActivityIndicator IsRunning="{Binding IsLoadingRececaoMaterial}"
                                                   IsVisible="{Binding IsLoadingRececaoMaterial}"
                                                   HorizontalOptions="Center" />

                                <Label Text="{Binding RececaoMaterialErrorMessage}"
                                       IsVisible="{Binding HasRececaoMaterialError}"
                                       TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                                       FontSize="13" />

                                <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                        Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                        StrokeThickness="1"
                                        Padding="16"
                                        IsVisible="{Binding HasSelectedMoldeRececao}">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="12">
                                        <Label Text="Pecas pendentes para este molde"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                                        <Label Text="{Binding PecasRececaoSelectionSummary}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                        <CollectionView ItemsSource="{Binding PecasPendentesRececao}"
                                                        SelectionMode="None"
                                                        HeightRequest="280"
                                                        IsVisible="{Binding HasPecasPendentesRececao}">
                                            <CollectionView.ItemsLayout>
                                                <LinearItemsLayout Orientation="Vertical"
                                                                   ItemSpacing="10" />
                                            </CollectionView.ItemsLayout>

                                            <CollectionView.ItemTemplate>
                                                <DataTemplate x:DataType="viewmodel:SelectablePecaRececaoItem">
                                                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1"
                                                            Padding="14">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16" />
                                                        </Border.StrokeShape>

                                                        <Grid ColumnDefinitions="Auto,*"
                                                              ColumnSpacing="12">
                                                            <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                      VerticalOptions="Start" />

                                                            <VerticalStackLayout Grid.Column="1"
                                                                                 Spacing="4">
                                                                <Grid ColumnDefinitions="*,Auto"
                                                                      ColumnSpacing="10">
                                                                    <VerticalStackLayout Spacing="2">
                                                                        <Label Text="{Binding DesignacaoDisplay}"
                                                                               FontFamily="OpenSansSemibold"
                                                                               FontSize="14"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                                        <Label Text="{Binding NumeroPecaDisplay, StringFormat='Numero: {0}'}"
                                                                               FontSize="12"
                                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                                    </VerticalStackLayout>

                                                                    <Border Grid.Column="1"
                                                                            Background="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                                                            StrokeThickness="0"
                                                                            Padding="10,6"
                                                                            VerticalOptions="Start">
                                                                        <Border.StrokeShape>
                                                                            <RoundRectangle CornerRadius="12" />
                                                                        </Border.StrokeShape>
                                                                        <Label Text="{Binding PrioridadeDisplay}"
                                                                               FontSize="11"
                                                                               FontFamily="OpenSansSemibold"
                                                                               TextColor="{AppThemeBinding Light={StaticResource Info}, Dark=#BFDBFE}" />
                                                                    </Border>
                                                                </Grid>

                                                                <Label Text="{Binding MaterialDisplay, StringFormat='Material: {0}'}"
                                                                       FontSize="12"
                                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                                <Label Text="{Binding QuantidadeDisplay}"
                                                                       FontSize="12"
                                                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            </VerticalStackLayout>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </CollectionView.ItemTemplate>
                                        </CollectionView>

                                        <Label Text="Todas as pecas deste molde ja tem o material recebido."
                                               IsVisible="{Binding HasNoPecasPendentesRececao}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                        <Button Text="{Binding RececaoMaterialButtonText}"
                                                Command="{Binding RegistarChegadaMaterialCommand}"
                                                IsEnabled="{Binding CanRegistarChegadaMaterial}"
                                                HorizontalOptions="Start" />
                                    </VerticalStackLayout>
                                </Border>
                            </VerticalStackLayout>
                        </Border>
                    </VerticalStackLayout>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
