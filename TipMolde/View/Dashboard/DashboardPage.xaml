<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             xmlns:viewmodel="clr-namespace:TipMolde.ViewModel"
             xmlns:models="clr-namespace:TipMolde.Models"
             x:Class="TipMolde.View.DashboardPage"
             x:Name="PaginaDashboard">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">
        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Dashboard" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{Binding ResponsiveContentPadding, Source={x:Reference PaginaDashboard}}"
                                     Spacing="{OnIdiom Phone='16', Desktop='18'}">

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="{OnIdiom Phone='18', Desktop='24'}">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="16">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Planeamento semanal"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="{OnIdiom Phone='20', Desktop='24'}"
                                           LineBreakMode="WordWrap"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    <Label Text="Escolhe a semana inicial e quantas semanas queres ver. Os moldes sao distribuidos num calendario semanal continuo."
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                           LineBreakMode="WordWrap" />
                                </VerticalStackLayout>

                                <Border Grid.Column="1"
                                        BackgroundColor="{AppThemeBinding Light=#F1F5F9, Dark=#111827}"
                                        StrokeThickness="0"
                                        Padding="14,10"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="18" />
                                    </Border.StrokeShape>

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="Periodo visivel"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding IntervaloPlanificacaoDisplay}"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="16"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                    </VerticalStackLayout>
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="14"
                                  RowSpacing="14">
                                <VerticalStackLayout Spacing="6">
                                    <Label Text="Semana inicial"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    <DatePicker Date="{Binding SemanaInicialPlanificacao, Mode=TwoWay}"
                                                Format="dd/MM/yyyy" />
                                    <Label Text="A data escolhida e alinhada automaticamente para domingo."
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="{Binding AdaptiveSecondaryColumn, Source={x:Reference PaginaDashboard}}"
                                                     Grid.Row="{Binding AdaptiveSecondaryRow, Source={x:Reference PaginaDashboard}}"
                                                     Spacing="6">
                                    <Label Text="Semanas visiveis"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    <HorizontalStackLayout Spacing="10">
                                        <Button Text="-"
                                                Command="{Binding ReduzirSemanasPlanificacaoCommand}"
                                                WidthRequest="44"
                                                HeightRequest="40" />
                                        <Label Text="{Binding NumeroSemanasPlanificacaoDisplay}"
                                               VerticalTextAlignment="Center"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="14"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Button Text="+"
                                                Command="{Binding AumentarSemanasPlanificacaoCommand}"
                                                WidthRequest="44"
                                                HeightRequest="40" />
                                    </HorizontalStackLayout>
                                </VerticalStackLayout>
                            </Grid>

                            <HorizontalStackLayout Spacing="10">
                                <Button Text="Semana anterior"
                                        Command="{Binding SemanaAnteriorPlanificacaoCommand}" />
                                <Button Text="Semana atual"
                                        Command="{Binding SemanaAtualPlanificacaoCommand}" />
                                <Button Text="Semana seguinte"
                                        Command="{Binding SemanaSeguintePlanificacaoCommand}" />
                            </HorizontalStackLayout>

                            <Label Text="{Binding PlanificacaoResumoDisplay}"
                                   FontSize="13"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="18"
                                    IsVisible="{Binding HasNoPlanificacao}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>
                                <Label Text="{Binding PlanificacaoVaziaDisplay}"
                                       HorizontalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </Border>

                            <Grid IsVisible="{Binding HasPlanificacao}">
                                <VerticalStackLayout x:Name="PlanificacaoCalendarRoot"
                                                     Spacing="12">
                                    <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                                          ColumnSpacing="0">
                                        <Label Text="Domingo"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Grid.Column="1"
                                               Text="Segunda-feira"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Grid.Column="2"
                                               Text="Terca-feira"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Grid.Column="3"
                                               Text="Quarta-feira"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Grid.Column="4"
                                               Text="Quinta-feira"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Grid.Column="5"
                                               Text="Sexta-feira"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Grid.Column="6"
                                               Text="Sabado"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="12"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    </Grid>

                                    <VerticalStackLayout Spacing="10"
                                                         BindableLayout.ItemsSource="{Binding PlanificacaoSemanas}">
                                        <BindableLayout.ItemTemplate>
                                            <DataTemplate x:DataType="models:DashboardPlanificacaoSemanaItem">
                                                <Grid ColumnDefinitions="*,*,*,*,*,*,*"
                                                      ColumnSpacing="8">
                                                    <Border WidthRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            HeightRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.SelecionarPlanificacaoDiaCommand, Source={x:Reference PaginaDashboard}}"
                                                                                  CommandParameter="{Binding DiaDomingo}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="18" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="6"
                                                                             Padding="10">
                                                            <Label Text="{Binding DiaDomingo.DiaSemanaDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DiaDomingo.DataDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="16"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <VerticalStackLayout Spacing="4"
                                                                                 BindableLayout.ItemsSource="{Binding DiaDomingo.MoldesVisiveis}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:FilaGlobalMoldeItemDto">
                                                                        <Border BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                                                                StrokeThickness="0"
                                                                                Padding="6,4">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="10" />
                                                                            </Border.StrokeShape>
                                                                            <Border.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding BindingContext.AbrirMoldePlanificacaoCommand, Source={x:Reference PaginaDashboard}}"
                                                                                                      CommandParameter="{Binding .}" />
                                                                            </Border.GestureRecognizers>
                                                                            <VerticalStackLayout Spacing="0">
                                                                                <Label Text="{Binding NumeroMoldeDisplay}"
                                                                                       FontFamily="OpenSansSemibold"
                                                                                       FontSize="10"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource Info}, Dark=#BFDBFE}" />
                                                                                <Label Text="{Binding NomeMoldeDisplay}"
                                                                                       FontSize="9"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                                            </VerticalStackLayout>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>
                                                            <Label Text="{Binding DiaDomingo.MoldesExtraCount, StringFormat='+{0} mais'}"
                                                                   IsVisible="{Binding DiaDomingo.TemMoldesExtra}"
                                                                   FontSize="10"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <Label Text="Sem moldes neste dia"
                                                                   IsVisible="{Binding DiaDomingo.SemMoldes}"
                                                                   FontSize="10"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Border>

                                                    <Border Grid.Column="1"
                                                            WidthRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            HeightRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.SelecionarPlanificacaoDiaCommand, Source={x:Reference PaginaDashboard}}"
                                                                                  CommandParameter="{Binding DiaSegunda}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="18" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="6"
                                                                             Padding="10">
                                                            <Label Text="{Binding DiaSegunda.DiaSemanaDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DiaSegunda.DataDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="16"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <VerticalStackLayout Spacing="4"
                                                                                 BindableLayout.ItemsSource="{Binding DiaSegunda.MoldesVisiveis}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:FilaGlobalMoldeItemDto">
                                                                        <Border BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                                                                StrokeThickness="0"
                                                                                Padding="6,4">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="10" />
                                                                            </Border.StrokeShape>
                                                                            <Border.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding BindingContext.AbrirMoldePlanificacaoCommand, Source={x:Reference PaginaDashboard}}"
                                                                                                      CommandParameter="{Binding .}" />
                                                                            </Border.GestureRecognizers>
                                                                            <VerticalStackLayout Spacing="0">
                                                                                <Label Text="{Binding NumeroMoldeDisplay}"
                                                                                       FontFamily="OpenSansSemibold"
                                                                                       FontSize="10"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource Info}, Dark=#BFDBFE}" />
                                                                                <Label Text="{Binding NomeMoldeDisplay}"
                                                                                       FontSize="9"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                                            </VerticalStackLayout>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>
                                                            <Label Text="{Binding DiaSegunda.MoldesExtraCount, StringFormat='+{0} mais'}"
                                                                   IsVisible="{Binding DiaSegunda.TemMoldesExtra}"
                                                                   FontSize="10"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <Label Text="Sem moldes neste dia"
                                                                   IsVisible="{Binding DiaSegunda.SemMoldes}"
                                                                   FontSize="10"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Border>

                                                    <Border Grid.Column="2"
                                                            WidthRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            HeightRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.SelecionarPlanificacaoDiaCommand, Source={x:Reference PaginaDashboard}}"
                                                                                  CommandParameter="{Binding DiaTerca}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="18" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="6"
                                                                             Padding="10">
                                                            <Label Text="{Binding DiaTerca.DiaSemanaDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DiaTerca.DataDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="16"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <VerticalStackLayout Spacing="4"
                                                                                 BindableLayout.ItemsSource="{Binding DiaTerca.MoldesVisiveis}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:FilaGlobalMoldeItemDto">
                                                                        <Border BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                                                                StrokeThickness="0"
                                                                                Padding="6,4">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="10" />
                                                                            </Border.StrokeShape>
                                                                            <Border.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding BindingContext.AbrirMoldePlanificacaoCommand, Source={x:Reference PaginaDashboard}}"
                                                                                                      CommandParameter="{Binding .}" />
                                                                            </Border.GestureRecognizers>
                                                                            <VerticalStackLayout Spacing="0">
                                                                                <Label Text="{Binding NumeroMoldeDisplay}"
                                                                                       FontFamily="OpenSansSemibold"
                                                                                       FontSize="10"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource Info}, Dark=#BFDBFE}" />
                                                                                <Label Text="{Binding NomeMoldeDisplay}"
                                                                                       FontSize="9"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                                            </VerticalStackLayout>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>
                                                            <Label Text="{Binding DiaTerca.MoldesExtraCount, StringFormat='+{0} mais'}"
                                                                   IsVisible="{Binding DiaTerca.TemMoldesExtra}"
                                                                   FontSize="10"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <Label Text="Sem moldes neste dia"
                                                                   IsVisible="{Binding DiaTerca.SemMoldes}"
                                                                   FontSize="10"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Border>

                                                    <Border Grid.Column="3"
                                                            WidthRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            HeightRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.SelecionarPlanificacaoDiaCommand, Source={x:Reference PaginaDashboard}}"
                                                                                  CommandParameter="{Binding DiaQuarta}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="18" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="6"
                                                                             Padding="10">
                                                            <Label Text="{Binding DiaQuarta.DiaSemanaDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DiaQuarta.DataDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="16"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <VerticalStackLayout Spacing="4"
                                                                                 BindableLayout.ItemsSource="{Binding DiaQuarta.MoldesVisiveis}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:FilaGlobalMoldeItemDto">
                                                                        <Border BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                                                                StrokeThickness="0"
                                                                                Padding="6,4">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="10" />
                                                                            </Border.StrokeShape>
                                                                            <Border.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding BindingContext.AbrirMoldePlanificacaoCommand, Source={x:Reference PaginaDashboard}}"
                                                                                                      CommandParameter="{Binding .}" />
                                                                            </Border.GestureRecognizers>
                                                                            <VerticalStackLayout Spacing="0">
                                                                                <Label Text="{Binding NumeroMoldeDisplay}"
                                                                                       FontFamily="OpenSansSemibold"
                                                                                       FontSize="10"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource Info}, Dark=#BFDBFE}" />
                                                                                <Label Text="{Binding NomeMoldeDisplay}"
                                                                                       FontSize="9"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                                            </VerticalStackLayout>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
                                                            </VerticalStackLayout>
                                                            <Label Text="{Binding DiaQuarta.MoldesExtraCount, StringFormat='+{0} mais'}"
                                                                   IsVisible="{Binding DiaQuarta.TemMoldesExtra}"
                                                                   FontSize="10"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <Label Text="Sem moldes neste dia"
                                                                   IsVisible="{Binding DiaQuarta.SemMoldes}"
                                                                   FontSize="10"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        </VerticalStackLayout>
                                                    </Border>

                                                    <Border Grid.Column="4"
                                                            WidthRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            HeightRequest="{Binding BindingContext.PlanificacaoCellSize, Source={x:Reference PaginaDashboard}}"
                                                            BackgroundColor="{AppThemeBinding Light=#FFFFFF, Dark=#111827}"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1">
                                                        <Border.GestureRecognizers>
                                                            <TapGestureRecognizer Command="{Binding BindingContext.SelecionarPlanificacaoDiaCommand, Source={x:Reference PaginaDashboard}}"
                                                                                  CommandParameter="{Binding DiaQuinta}" />
                                                        </Border.GestureRecognizers>
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="18" />
                                                        </Border.StrokeShape>
                                                        <VerticalStackLayout Spacing="6"
                                                                             Padding="10">
                                                            <Label Text="{Binding DiaQuinta.DiaSemanaDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="12"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                            <Label Text="{Binding DiaQuinta.DataDisplay}"
                                                                   FontFamily="OpenSansSemibold"
                                                                   FontSize="16"
                                                                   LineBreakMode="TailTruncation"
                                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                            <VerticalStackLayout Spacing="4"
                                                                                 BindableLayout.ItemsSource="{Binding DiaQuinta.MoldesVisiveis}">
                                                                <BindableLayout.ItemTemplate>
                                                                    <DataTemplate x:DataType="models:FilaGlobalMoldeItemDto">
                                                                        <Border BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1E3A8A}"
                                                                                StrokeThickness="0"
                                                                                Padding="6,4">
                                                                            <Border.StrokeShape>
                                                                                <RoundRectangle CornerRadius="10" />
                                                                            </Border.StrokeShape>
                                                                            <Border.GestureRecognizers>
                                                                                <TapGestureRecognizer Command="{Binding BindingContext.AbrirMoldePlanificacaoCommand, Source={x:Reference PaginaDashboard}}"
                                                                                                      CommandParameter="{Binding .}" />
                                                                            </Border.GestureRecognizers>
                                                                            <VerticalStackLayout Spacing="0">
                                                                                <Label Text="{Binding NumeroMoldeDisplay}"
                                                                                       FontFamily="OpenSansSemibold"
                                                                                       FontSize="10"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource Info}, Dark=#BFDBFE}" />
                                                                                <Label Text="{Binding NomeMoldeDisplay}"
                                                                                       FontSize="9"
                                                                                       LineBreakMode="TailTruncation"
                                                                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                                            </VerticalStackLayout>
                                                                        </Border>
                                                                    </DataTemplate>
                                                                </BindableLayout.ItemTemplate>
