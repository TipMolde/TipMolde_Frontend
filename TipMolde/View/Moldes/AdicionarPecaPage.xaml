<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.AdicionarPecaPage"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

        <Border Grid.Row="0"
                BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                Padding="24,18">
            <VerticalStackLayout Spacing="2">
                <Label Text="Criar peça"
                       FontFamily="OpenSansSemibold"
                       FontSize="24"
                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                <Label Text="{Binding NumeroMoldeDisplay, StringFormat='Molde: {0}'}"
                       FontSize="13"
                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
            </VerticalStackLayout>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="{StaticResource PageContentPadding}"
                                 Spacing="18">
                <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                        Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                        StrokeThickness="1"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">
                        <Label Text="Dados da peça"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Número da peça"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding NumeroPeca}"
                                       Placeholder="Opcional"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8">
                                <Label Text="Designacao"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding Designacao}"
                                       Placeholder="Obrigatoria"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Prioridade"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding Prioridade}"
                                       Keyboard="Numeric"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8">
                                <Label Text="Quantidade"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding Quantidade}"
                                       Keyboard="Numeric"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Proxima fase"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Picker Title="Selecionar próxima fase"
                                    ItemsSource="{Binding FasesProducao}"
                                    SelectedItem="{Binding SelectedProximaFase, Mode=TwoWay}"
                                    ItemDisplayBinding="{Binding NomeDisplay}" />
                        </VerticalStackLayout>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Referencia"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding Referencia}"
                                       Placeholder="Opcional"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8">
                                <Label Text="Material"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding MaterialDesignacao}"
                                       Placeholder="Opcional"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="16">
                            <VerticalStackLayout Spacing="8">
                                <Label Text="Tratamento termico"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding TratamentoTermico}"
                                       Placeholder="Opcional"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Grid.Column="1"
                                                 Spacing="8">
                                <Label Text="Massa"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="14"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                <Entry Text="{Binding Massa}"
                                       Placeholder="Opcional"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                       ClearButtonVisibility="WhileEditing" />
                            </VerticalStackLayout>
                        </Grid>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Observacao"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                            <Editor Text="{Binding Observacao}"
                                    Placeholder="Opcional"
                                    AutoSize="TextChanges"
                                    HeightRequest="100"
                                    TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                                    BackgroundColor="{AppThemeBinding Light=White, Dark=#111827}" />
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                               FontSize="13" />

                        <ActivityIndicator IsRunning="{Binding IsSaving}"
                                           IsVisible="{Binding IsSaving}"
                                           HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="Auto,Auto"
                              ColumnSpacing="12">
                            <Button Text="Voltar"
                                    Command="{Binding VoltarCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    HeightRequest="44" />

                            <Button Grid.Column="1"
                                    Text="Criar peça"
                                    Command="{Binding CreateCommand}"
                                    IsEnabled="{Binding CanCreate}"
                                    BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
