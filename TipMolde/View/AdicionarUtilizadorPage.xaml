<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.AdicionarUtilizadorPage"
             xmlns:viewmodel="clr-namespace:TipMolde.ViewModel"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{StaticResource Surface}">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{StaticResource Surface}">

        <Border Grid.Row="0"
                BackgroundColor="White"
                Stroke="{StaticResource CardBorderBrush}"
                Padding="24,18">
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="16">

                <VerticalStackLayout Grid.Column="1"
                                     Spacing="2"
                                     VerticalOptions="Center">
                    <Label Text="Adicionar utilizador"
                           FontFamily="OpenSansSemibold"
                           FontSize="24"
                           TextColor="{StaticResource TextPrimary}" />
                    <Label Text="Cria uma nova conta e volta automaticamente para a lista."
                           FontSize="13"
                           TextColor="{StaticResource TextSecondary}" />
                </VerticalStackLayout>
            </Grid>
        </Border>

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="28"
                                 Spacing="20">
                <Border BackgroundColor="White"
                        Stroke="{StaticResource CardBorderBrush}"
                        StrokeThickness="1"
                        Padding="24">
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="24" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="18">
                        <Label Text="Dados do utilizador"
                               FontFamily="OpenSansSemibold"
                               FontSize="20"
                               TextColor="{StaticResource TextPrimary}" />

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Nome"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Entry Text="{Binding Nome}"
                                   Placeholder="Nome completo"
                                   TextColor="{StaticResource TextPrimary}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Email"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Entry Text="{Binding Email}"
                                   Placeholder="utilizador@tipmolde.pt"
                                   Keyboard="Email"
                                   TextColor="{StaticResource TextPrimary}"
                                   ClearButtonVisibility="WhileEditing" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Password inicial"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="14"
                                   TextColor="{StaticResource TextPrimary}" />
                            <Entry Text="{Binding Password}"
                                   Placeholder="Password inicial"
                                   IsPassword="True"
                                   ClearButtonVisibility="WhileEditing"
                                   TextColor="{StaticResource TextPrimary}"/>
                            <Label Text="Minimo 8 caracteres, com maiuscula, minuscula, numero e simbolo."
                                   FontSize="12"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8">
                            <Label Text="Cargo"
                               FontFamily="OpenSansSemibold"
                               FontSize="14"
                               TextColor="{StaticResource TextPrimary}" />
                            <Picker Title="Selecionar cargo"
                                ItemsSource="{Binding AvailableRoles}"
                                SelectedItem="{Binding SelectedRole, Mode=TwoWay}"
                                TextColor="{StaticResource TextPrimary}"
                                BackgroundColor="#F8FAFC" />
                        </VerticalStackLayout>

                        <Label Text="{Binding ErrorMessage}"
                               IsVisible="{Binding HasError}"
                               TextColor="{StaticResource Danger}"
                               FontSize="13" />

                        <ActivityIndicator IsRunning="{Binding IsSaving}"
                                           IsVisible="{Binding IsSaving}"
                                           HorizontalOptions="Center" />

                        <Grid ColumnDefinitions="Auto,Auto"
                              ColumnSpacing="12">
                            <Button Text="Voltar"
                                    Command="{Binding VoltarCommand}"
                                    BackgroundColor="#E2E8F0"
                                    TextColor="#0F172A"
                                    HeightRequest="44" />

                            <Button Grid.Column="1"
                                    Text="Criar utilizador"
                                    Command="{Binding CreateCommand}"
                                    BackgroundColor="#0F172A"
                                    TextColor="White"
                                    HeightRequest="44" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>
