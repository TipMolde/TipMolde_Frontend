<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TipMolde.Models"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             x:Class="TipMolde.View.MaquinaDetalhePage"
             x:Name="PaginaMaquinaDetalhe"
             Shell.NavBarIsVisible="False"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid ColumnDefinitions="Auto,*">
        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Detalhes da Maquina" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{StaticResource PageContentPadding}"
                                     Spacing="18">

                    <Grid ColumnDefinitions="Auto,Auto,*"
                          RowDefinitions="Auto,Auto"
                          ColumnSpacing="10"
                          RowSpacing="10">
                        <Button Text="Voltar"
                                Command="{Binding VoltarCommand}"
                                BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                HeightRequest="42" />
                        <Button Grid.Column="{OnIdiom Phone='1', Desktop='1'}"
                                Grid.Row="{OnIdiom Phone='0', Desktop='0'}"
                                Text="Recarregar"
                                Command="{Binding RecarregarCommand}"
                                BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                HeightRequest="42" />
                    </Grid>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HorizontalOptions="Center" />

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                           FontSize="13" />

                    <Label Text="{Binding InfoMessage}"
                           IsVisible="{Binding HasInfo}"
                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                           FontSize="13" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="22">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="18">
                            <Grid ColumnDefinitions="*,Auto"
                                  RowDefinitions="Auto,Auto"
                                  ColumnSpacing="12"
                                  RowSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="{Binding MaquinaTitulo}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="24" />
                                    <Label Text="{Binding Maquina.FaseDedicadaDisplay, StringFormat='Fase dedicada: {0}'}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>

                                <Border Grid.Column="{OnIdiom Phone='0', Desktop='1'}"
                                        Grid.Row="{OnIdiom Phone='1', Desktop='0'}"
                                        BackgroundColor="{Binding Maquina.EstadoBadgeBackground}"
                                        StrokeThickness="0"
                                        Padding="10,6"
                                        VerticalOptions="Start">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="14" />
                                    </Border.StrokeShape>
                                    <Label Text="{Binding Maquina.EstadoDisplay}"
                                           TextColor="{Binding Maquina.EstadoBadgeForeground}"
                                           FontFamily="OpenSansSemibold" />
                                </Border>
                            </Grid>

                            <Grid ColumnDefinitions="*,*,*"
                                  RowDefinitions="Auto,Auto,Auto"
                                  ColumnSpacing="18"
                                  RowSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="IP"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding Maquina.IpAddressDisplay}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="{OnIdiom Phone='0', Desktop='1'}"
                                                     Grid.Row="{OnIdiom Phone='1', Desktop='0'}"
                                                     Spacing="4">
                                    <Label Text="Protocolo"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding Maquina.ProtocoloComunicacaoDisplay}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>

                                <VerticalStackLayout Grid.Column="{OnIdiom Phone='0', Desktop='2'}"
                                                     Grid.Row="{OnIdiom Phone='2', Desktop='0'}"
                                                     Spacing="4">
                                    <Label Text="Evento pendente"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Label Text="{Binding EventoPendenteDisplay}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>
                            </Grid>
                        </VerticalStackLayout>
                    </Border>

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="22">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">
                            <VerticalStackLayout Spacing="4">
                                <Label Text="Contexto de trabalho"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="20" />
                                <Label Text="{Binding UtilizadorAtualDisplay, StringFormat='Gestor de produção: {0}'}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                <Label Text="{Binding EventoPendenteDisplay, StringFormat='Acao pendente: {0}'}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </VerticalStackLayout>

                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="16"
                                    IsVisible="{Binding HasSessaoAtiva}">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="18" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="10">
                                    <Label Text="{Binding SessaoAtiva.ContextoTituloDisplay}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="16" />
                                    <Label Text="{Binding SessaoAtiva.TelemetriaAvisoDisplay}"
                                           IsVisible="{Binding SessaoAtiva.TelemetriaDesatualizada}"
                                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}" />
                                    <Grid ColumnDefinitions="*,*"
                                          RowDefinitions="Auto,Auto,Auto"
                                          ColumnSpacing="14"
                                          RowSpacing="10">
                                        <VerticalStackLayout Spacing="4">
                                            <Label Text="Peça"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13" />
                                            <Label Text="{Binding SessaoAtiva.PecaResumoDisplay}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Column="1"
                                                             Spacing="4">
                                            <Label Text="Molde"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13" />
                                            <Label Text="{Binding SessaoAtiva.NumeroMoldeDisplay}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1"
                                                             Spacing="4">
                                            <Label Text="Fase"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13" />
                                            <Label Text="{Binding SessaoAtiva.FaseDisplay}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="1"
                                                             Grid.Column="1"
                                                             Spacing="4">
                                            <Label Text="Sessão"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13" />
                                            <Label Text="{Binding SessaoAtiva.EstadoSessaoDisplay}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="2"
                                                             Spacing="4">
                                            <Label Text="Último estado da máquina"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13" />
                                            <Label Text="{Binding SessaoAtiva.UltimoEstadoMaquinaDisplay}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                        </VerticalStackLayout>

                                        <VerticalStackLayout Grid.Row="2"
                                                             Grid.Column="1"
                                                             Spacing="4">
                                            <Label Text="Última atividade"
                                                   FontFamily="OpenSansSemibold"
                                                   FontSize="13" />
                                            <Label Text="{Binding SessaoAtiva.LastSeenAtDisplay}"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                        </VerticalStackLayout>
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <VerticalStackLayout Spacing="16"
                                                 IsVisible="{Binding NeedsContextSelection}">
                                <Label Text="{Binding SelectedPecaDisplay, StringFormat='Peça selecionada: {0}'}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                <Label Text="{Binding Maquina.FaseDedicadaDisplay, StringFormat='Só são apresentadas peças cuja próxima fase é: {0}'}"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                <Grid ColumnDefinitions="*,Auto"
                                      RowDefinitions="Auto,Auto"
                                      ColumnSpacing="10"
                                      RowSpacing="10">
                                    <Entry Text="{Binding PesquisaPeca, Mode=TwoWay}"
                                           Placeholder="Pesquisar por número ou nome da peça"
                                           ReturnCommand="{Binding PesquisarPecasCommand}" />
                                    <Button Grid.Column="{OnIdiom Phone='0', Desktop='1'}"
                                            Grid.Row="{OnIdiom Phone='1', Desktop='0'}"
                                            Text="Pesquisar"
                                            Command="{Binding PesquisarPecasCommand}"
                                            BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                            TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                            HeightRequest="42" />
                                </Grid>

                                <ActivityIndicator IsRunning="{Binding IsSearchingPecas}"
                                                   IsVisible="{Binding IsSearchingPecas}"
                                                   HorizontalOptions="Center" />

                                <Label Text="Pesquisa uma peça por número ou nome para a associar a esta máquina."
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                       HorizontalOptions="Center"
                                       Margin="0,20">
                                    <Label.Triggers>
                                        <DataTrigger TargetType="Label"
                                                     Binding="{Binding HasPecasEncontradas}"
                                                     Value="True">
                                            <Setter Property="IsVisible" Value="False" />
                                        </DataTrigger>
                                    </Label.Triggers>
                                </Label>

                                <VerticalStackLayout Spacing="10"
                                                     BindableLayout.ItemsSource="{Binding PecasEncontradas}">
                                    <BindableLayout.ItemTemplate>
                                        <DataTemplate x:DataType="models:ProducaoPecaDisponivelItem">
                                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                    StrokeThickness="1"
                                                    Padding="14"
                                                    Margin="0,0,0,10">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="16" />
                                                </Border.StrokeShape>

                                                <Grid ColumnDefinitions="*,Auto"
                                                      RowDefinitions="Auto,Auto"
                                                      ColumnSpacing="12"
                                                      RowSpacing="10">
                                                    <VerticalStackLayout Spacing="4">
                                                        <Label Text="{Binding DesignacaoDisplay}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="16" />
                                                        <Label Text="{Binding NumeroPecaDisplay, StringFormat='Número: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        <Label Text="{Binding NumeroMoldeDisplay, StringFormat='Molde: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        <Label Text="{Binding ProximaFaseDisplay, StringFormat='Próxima fase: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                    </VerticalStackLayout>

                                                    <Button Grid.Column="{OnIdiom Phone='0', Desktop='1'}"
                                                            Grid.Row="{OnIdiom Phone='1', Desktop='0'}"
                                                            Text="Selecionar"
                                                            Command="{Binding BindingContext.SelecionarPecaCommand, Source={x:Reference PaginaMaquinaDetalhe}}"
                                                            CommandParameter="{Binding .}"
                                                            BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                                            TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                                            HeightRequest="40"
                                                            HorizontalOptions="{OnIdiom Phone='Fill', Desktop='End'}"
                                                            VerticalOptions="Center" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </BindableLayout.ItemTemplate>
                                </VerticalStackLayout>

                                <shared:PaginationBarView Page="{Binding Page}"
                                                          TotalPages="{Binding TotalPages}"
                                                          PageInput="{Binding PageInput}"
                                                          CanGoFirst="{Binding CanGoFirst}"
                                                          CanGoPrevious="{Binding CanGoPrevious}"
                                                          CanGoNext="{Binding CanGoNext}"
                                                          CanGoLast="{Binding CanGoLast}"
                                                          FirstPageCommand="{Binding FirstPageCommand}"
                                                          PreviousPageCommand="{Binding PreviousPageCommand}"
                                                          GoToPageCommand="{Binding GoToPageCommand}"
                                                          NextPageCommand="{Binding NextPageCommand}"
                                                          LastPageCommand="{Binding LastPageCommand}"
                                                          IsVisible="{Binding HasPecasEncontradas}" />

                                <Button Text="Confirmar gestor e peça"
                                        Command="{Binding CompletarContextoCommand}"
                                        IsEnabled="{Binding CanCompletarContexto}"
                                        BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                        TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                        HeightRequest="46" />
                            </VerticalStackLayout>

                            <VerticalStackLayout Spacing="14"
                                                 IsVisible="{Binding HasEventoStoppedPendente}">
                                <Label Text="A máquina enviou STOPPED. Indica se o trabalho terminou ou se foi apenas uma pausa."
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                <VerticalStackLayout Spacing="8"
                                                     IsVisible="{Binding CanEscolherProximaFase}">
                                    <Label Text="Próxima fase da peça"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="13" />
                                    <Picker Title="Selecionar proxima fase"
                                            ItemsSource="{Binding ProximasFasesDisponiveis}"
                                            SelectedItem="{Binding SelectedProximaFase, Mode=TwoWay}"
                                            ItemDisplayBinding="{Binding NomeDisplay}" />
                                    <Label Text="{Binding ProximaFasePlaneadaDisplay, StringFormat='Fase selecionada: {0}'}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>
                                <Grid ColumnDefinitions="*,*"
                                      ColumnSpacing="12">
                                    <Button Text="Marcar pausa"
                                            Command="{Binding ConfirmarPausaCommand}"
                                            IsEnabled="{Binding CanConfirmarParagem}"
                                            BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                            TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                            HeightRequest="46" />
                                    <Button Grid.Column="1"
                                            Text="Terminar trabalho"
                                            Command="{Binding PrepararConclusaoCommand}"
                                            IsEnabled="{Binding CanIniciarConclusao}"
                                            IsVisible="{Binding CanIniciarConclusao}"
                                            BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                            TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                            HeightRequest="46" />
                                    <Button Grid.Column="1"
                                            Text="Confirmar conclusão"
                                            Command="{Binding ConfirmarConclusaoCommand}"
                                            IsEnabled="{Binding CanConfirmarConclusao}"
                                            IsVisible="{Binding IsConclusaoSelectionActive}"
                                            BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                            TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                            HeightRequest="46" />
                                </Grid>
                                <Button Text="Cancelar conclusão"
                                        Command="{Binding CancelarConclusaoCommand}"
                                        IsVisible="{Binding IsConclusaoSelectionActive}"
                                        BackgroundColor="Transparent"
                                        TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                        BorderColor="{AppThemeBinding Light=#CBD5E1, Dark=#334155}"
                                        BorderWidth="1"
                                        HeightRequest="42" />
                            </VerticalStackLayout>

                            <Label Text="Não existe nenhuma ação manual pendente para esta máquina."
                                   IsVisible="{Binding HasNoAcaoPendente}"
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                        </VerticalStackLayout>
                    </Border>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
