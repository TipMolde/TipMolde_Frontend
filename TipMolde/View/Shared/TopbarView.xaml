<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodel="clr-namespace:TipMolde.ViewModel"
             x:Class="TipMolde.View.Shared.TopBarView"
             x:Name="Self">

    <Border Padding="{Binding RootPadding, Source={x:Reference Self}}"
            Margin="0,0,0,2"
            BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark=#111827}"
            Stroke="{AppThemeBinding Light={StaticResource CardBorder}, Dark={StaticResource Gray600}}"
            StrokeThickness="1">

        <FlexLayout Direction="Row"
                    Wrap="Wrap"
                    JustifyContent="SpaceBetween"
                    AlignItems="Center"
                    AlignContent="Start">

            <HorizontalStackLayout FlexLayout.Grow="1"
                                   Spacing="12"
                                   VerticalOptions="Center">
                <Button Text="Menu"
                        Command="{Binding ViewModel.OpenNavigationMenuCommand, Source={x:Reference Self}}"
                        IsVisible="{Binding ShowNavigationMenu, Source={x:Reference Self}}"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandOrange}, Dark={StaticResource BrandOrangeDark}}"
                        TextColor="{AppThemeBinding Light=White, Dark=White}"
                        HeightRequest="40"
                        Padding="14,8" />

                <VerticalStackLayout Spacing="2"
                                     HorizontalOptions="Fill"
                                     VerticalOptions="Center">
                    <Label Text="{Binding TitleText, Source={x:Reference Self}}"
                           FontFamily="OpenSansSemibold"
                           FontSize="{Binding TitleFontSize, Source={x:Reference Self}}"
                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                           LineBreakMode="WordWrap" />
                </VerticalStackLayout>
            </HorizontalStackLayout>

            <HorizontalStackLayout Spacing="{Binding ActionsSpacing, Source={x:Reference Self}}"
                                   Margin="{Binding ActionsMargin, Source={x:Reference Self}}"
                                   HorizontalOptions="End"
                                   VerticalOptions="Center">

                <Border BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                        StrokeThickness="0"
                        Padding="{Binding UserBadgePadding, Source={x:Reference Self}}">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ViewModel.OpenDefinicoesCommand, Source={x:Reference Self}}" />
                    </Border.GestureRecognizers>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <HorizontalStackLayout Spacing="8">
                        <Label Text="{Binding ViewModel.DisplayUserName, Source={x:Reference Self}}"
                               FontFamily="OpenSansSemibold"
                               FontSize="{Binding UserNameFontSize, Source={x:Reference Self}}"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}"
                               MaxLines="1"
                               LineBreakMode="TailTruncation" />
                    </HorizontalStackLayout>
                </Border>

                <Button Text="Terminar sessão"
                        Command="{Binding ViewModel.LogoutCommand, Source={x:Reference Self}}"
                        BackgroundColor="Red"
                        TextColor="White"
                        FontSize="{Binding ActionFontSize, Source={x:Reference Self}}"
                        CornerRadius="18"
                        Padding="{Binding LogoutPadding, Source={x:Reference Self}}"
                        MinimumHeightRequest="44" />
            </HorizontalStackLayout>
        </FlexLayout>
    </Border>
</ContentView>
