<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.Shared.SidebarView"
             x:Name="Root">

    <Border WidthRequest="{Binding SidebarWidth, Source={x:Reference Root}}"
            Background="{StaticResource SidebarGradientBrush}"
            StrokeThickness="0"
            Padding="18,24,14,18">

        <Grid RowDefinitions="Auto,*">

            <Border BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderTapped" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout Spacing="14">
                    <Grid WidthRequest="56"
                          HeightRequest="56">
                        <Grid.Clip>
                            <RoundRectangleGeometry CornerRadius="16"
                                                    Rect="0,0,56,56" />
                        </Grid.Clip>
                        <Image Source="image.png"
                               Aspect="AspectFill" />
                    </Grid>

                    <VerticalStackLayout Spacing="2"
                                         VerticalOptions="Center"
                                         IsVisible="{Binding ShowLabels, Source={x:Reference Root}}">
                        <Label Text="TipMolde"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               TextColor="White" />
                        <Label Text="Sistema de Producao"
                               FontSize="12"
                               TextColor="#CBD5E1" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="1"
                                 Spacing="10"
                                 Margin="0,20,0,0"
                                 VerticalOptions="Start">

                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDashboardCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Border Background="#1E293B"
                                StrokeThickness="0"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="D"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White" />
                        </Border>
                        <Label Text="Dashboard"
                               IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               VerticalOptions="Center"
                               TextColor="#E2E8F0" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenUtilizadoresCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Border Background="#1E293B"
                                StrokeThickness="0"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="U"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White" />
                        </Border>
                        <Label Text="Utilizadores"
                               IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               VerticalOptions="Center"
                               TextColor="#E2E8F0" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenClientesCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Border Background="#1E293B"
                                StrokeThickness="0"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="C"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White" />
                        </Border>
                        <Label Text="Clientes"
                               IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               VerticalOptions="Center"
                               TextColor="#E2E8F0" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenEncomendasCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Border Background="#1E293B"
                                StrokeThickness="0"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="E"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White" />
                        </Border>
                        <Label Text="Encomendas"
                               IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               VerticalOptions="Center"
                               TextColor="#E2E8F0" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenProducaoCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Border Background="#1E293B"
                                StrokeThickness="0"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="P"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White" />
                        </Border>
                        <Label Text="Producao"
                               IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               VerticalOptions="Center"
                               TextColor="#E2E8F0" />
                    </HorizontalStackLayout>
                </Border>

                <Border BackgroundColor="Transparent"
                        StrokeThickness="0"
                        Padding="12,12">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenDefinicoesCommand}" />
                    </Border.GestureRecognizers>
                    <HorizontalStackLayout Spacing="12">
                        <Border Background="#1E293B"
                                StrokeThickness="0"
                                Padding="10,6">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="12" />
                            </Border.StrokeShape>
                            <Label Text="F"
                                   FontFamily="OpenSansSemibold"
                                   TextColor="White" />
                        </Border>
                        <Label Text="Definicoes"
                               IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                               FontFamily="OpenSansSemibold"
                               FontSize="18"
                               VerticalOptions="Center"
                               TextColor="#E2E8F0" />
                    </HorizontalStackLayout>
                </Border>

            </VerticalStackLayout>
        </Grid>
    </Border>
</ContentView>