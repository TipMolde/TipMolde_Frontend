<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TipMolde.View.Shared.SidebarView"
             x:Name="Root">

    <Border WidthRequest="{Binding SidebarWidth, Source={x:Reference Root}}"
            Background="{StaticResource SidebarGradientBrush}"
            StrokeThickness="0"
            Padding="18,24,14,18">

        <Grid RowDefinitions="Auto,*">

            <Border BackgroundColor="Transparent"
                    StrokeThickness="0"
                    Padding="6">
                <Border.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnHeaderTapped" />
                </Border.GestureRecognizers>

                <HorizontalStackLayout Spacing="14">
                    <Grid WidthRequest="84"
                          HeightRequest="56">
                        <Grid.Clip>
                            <RoundRectangleGeometry CornerRadius="14"
                                                    Rect="0,0,84,56" />
                        </Grid.Clip>
                        <Image Source="image.png"
                               Aspect="AspectFit" />
                    </Grid>

                    <VerticalStackLayout Spacing="2"
                                         VerticalOptions="Center"
                                         IsVisible="{Binding ShowLabels, Source={x:Reference Root}}">
                        <Label Text="TipMolde"
                               FontFamily="OpenSansSemibold"
                               FontSize="24"
                               TextColor="White" />
                        <Label Text="Sistema de Producao"
                               FontSize="12"
                               TextColor="#CBD5E1" />
                    </VerticalStackLayout>
                </HorizontalStackLayout>
            </Border>

            <ScrollView Grid.Row="1"
                        Margin="0,20,0,0"
                        VerticalScrollBarVisibility="Never">
                <VerticalStackLayout Spacing="10"
                                     VerticalOptions="Start">

                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="12,12"
                            IsVisible="{Binding ViewModel.CanViewDashboard, Source={x:Reference Root}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewModel.OpenDashboardCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Border Background="#1E293B"
                                    StrokeThickness="0"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="D"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White" />
                            </Border>
                            <Label Text="Dashboard"
                                   IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#E2E8F0" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="12,12"
                            IsVisible="{Binding ViewModel.CanViewUtilizadores, Source={x:Reference Root}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewModel.OpenUtilizadoresCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Border Background="#1E293B"
                                    StrokeThickness="0"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="U"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White" />
                            </Border>
                            <Label Text="Utilizadores"
                                   IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#E2E8F0" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="12,12"
                            IsVisible="{Binding ViewModel.CanViewClientes, Source={x:Reference Root}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewModel.OpenClientesCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Border Background="#1E293B"
                                    StrokeThickness="0"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="C"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White" />
                            </Border>
                            <Label Text="Clientes"
                                   IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#E2E8F0" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="12,12"
                            IsVisible="{Binding ViewModel.CanViewEncomendas, Source={x:Reference Root}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewModel.OpenEncomendasCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Border Background="#1E293B"
                                    StrokeThickness="0"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="E"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White" />
                            </Border>
                            <Label Text="Encomendas"
                                   IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#E2E8F0" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="12,12"
                            IsVisible="{Binding ViewModel.CanViewProducao, Source={x:Reference Root}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewModel.OpenProducaoCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Border Background="#1E293B"
                                    StrokeThickness="0"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="P"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White" />
                            </Border>
                            <Label Text="Producao"
                                   IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#E2E8F0" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="12,12"
                            IsVisible="{Binding ViewModel.CanViewMaquinas, Source={x:Reference Root}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewModel.OpenMaquinasCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Border Background="#1E293B"
                                    StrokeThickness="0"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="M"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White" />
                            </Border>
                            <Label Text="Maquinas"
                                   IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#E2E8F0" />
                        </HorizontalStackLayout>
                    </Border>

                    <Border BackgroundColor="Transparent"
                            StrokeThickness="0"
                            Padding="12,12"
                            IsVisible="{Binding ViewModel.CanViewDesenho, Source={x:Reference Root}}">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding ViewModel.OpenDesenhoCommand, Source={x:Reference Root}}" />
                        </Border.GestureRecognizers>
                        <HorizontalStackLayout Spacing="12">
                            <Border Background="#1E293B"
                                    StrokeThickness="0"
                                    Padding="10,6">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="12" />
                                </Border.StrokeShape>
                                <Label Text="Dn"
                                       FontFamily="OpenSansSemibold"
                                       TextColor="White" />
                            </Border>
                            <Label Text="Desenho"
                                   IsVisible="{Binding ShowLabels, Source={x:Reference Root}}"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="18"
                                   VerticalOptions="Center"
                                   TextColor="#E2E8F0" />
                        </HorizontalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Border>
</ContentView>
