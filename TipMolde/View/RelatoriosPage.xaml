<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TipMolde.Models"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             x:Class="TipMolde.View.RelatoriosPage"
             x:Name="PaginaRelatorios"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

            <shared:TopBarView Grid.Row="0"
                               TitleText="Relatorios de Producao" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="28,22,28,20"
                                     Spacing="18">

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="24">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="28" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="12">
                            <Label Text="Exportacao assistida de FTL, FRE, FRM, FRA e FOP"
                                   FontFamily="OpenSansSemibold"
                                   FontSize="24"
                                   TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                            <Label Text="Seleciona um molde, escolhe o contexto da encomenda e usa a pre-visualizacao para validar o ficheiro antes da geracao final."
                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                            <Grid ColumnDefinitions="*,Auto,Auto"
                                  ColumnSpacing="12">
                                <SearchBar Grid.Column="0"
                                           Placeholder="Pesquisar molde por numero, nome ou numero do cliente"
                                           Text="{Binding SearchTerm}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                                <Button Grid.Column="1"
                                        Text="Atualizar"
                                        Command="{Binding RecarregarCommand}"
                                        HeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                        TextColor="{AppThemeBinding Light=White, Dark=#0F172A}" />

                                <Button Grid.Column="2"
                                        Text="Limpar"
                                        Command="{Binding LimparPesquisaCommand}"
                                        IsEnabled="{Binding HasSearch}"
                                        HeightRequest="44"
                                        BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                        TextColor="{AppThemeBinding Light=#0F172A, Dark=White}" />
                            </Grid>

                            <Label Text="{Binding ErrorMessage}"
                                   IsVisible="{Binding HasError}"
                                   TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                                   FontSize="13" />
                        </VerticalStackLayout>
                    </Border>

                    <ActivityIndicator IsRunning="{Binding IsBusy}"
                                       IsVisible="{Binding IsBusy}"
                                       HorizontalOptions="Center" />

                    <Grid ColumnDefinitions="1.1*,0.9*"
                          ColumnSpacing="18">

                        <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                StrokeThickness="1"
                                Padding="20">
                            <Border.StrokeShape>
                                <RoundRectangle CornerRadius="24" />
                            </Border.StrokeShape>

                            <VerticalStackLayout Spacing="16">
                                <Label Text="Moldes disponiveis"
                                       FontFamily="OpenSansSemibold"
                                       FontSize="18"
                                       TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                                <CollectionView ItemsSource="{Binding Moldes}"
                                                SelectionMode="None"
                                                HeightRequest="640">
                                    <CollectionView.EmptyView>
                                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                StrokeThickness="1"
                                                Padding="18">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="18" />
                                            </Border.StrokeShape>

                                            <Label Text="Nao existem moldes para apresentar com este filtro."
                                                   HorizontalOptions="Center"
                                                   TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                        </Border>
                                    </CollectionView.EmptyView>

                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical"
                                                           ItemSpacing="14" />
                                    </CollectionView.ItemsLayout>

                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:MoldeDto">
                                            <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                    StrokeThickness="1"
                                                    Padding="18">
                                                <Border.StrokeShape>
                                                    <RoundRectangle CornerRadius="20" />
                                                </Border.StrokeShape>

                                                <Grid ColumnDefinitions="68,*,Auto"
                                                      ColumnSpacing="14">
                                                    <Border WidthRequest="68"
                                                            HeightRequest="68"
                                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                            StrokeThickness="1"
                                                            BackgroundColor="{AppThemeBinding Light=White, Dark=#0F172A}">
                                                        <Border.StrokeShape>
                                                            <RoundRectangle CornerRadius="16" />
                                                        </Border.StrokeShape>

                                                        <Image Source="{Binding ImagemCapaSource}"
                                                               Aspect="AspectFill"
                                                               WidthRequest="68"
                                                               HeightRequest="68" />
                                                    </Border>

                                                    <VerticalStackLayout Grid.Column="1"
                                                                         Spacing="4">
                                                        <Label Text="{Binding Numero}"
                                                               FontFamily="OpenSansSemibold"
                                                               FontSize="18"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                                        <Label Text="{Binding Nome}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        <Label Text="{Binding NumeroMoldeCliente, StringFormat='Cliente: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}"
                                                               FontSize="13" />
                                                    </VerticalStackLayout>

                                                    <Button Grid.Column="2"
                                                            Text="Selecionar"
                                                            Command="{Binding BindingContext.SelecionarMoldeCommand, Source={x:Reference PaginaRelatorios}}"
                                                            CommandParameter="{Binding .}"
                                                            HeightRequest="42"
                                                            VerticalOptions="Center"
                                                            BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                                            TextColor="{AppThemeBinding Light=White, Dark=#0F172A}" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="18">

                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="20">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="14">
                                    <Label Text="Configuracao do relatorio"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                                    <VerticalStackLayout Spacing="4">
                                        <Label Text="Molde selecionado"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding SelectedMoldeDisplay}"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                        <Label Text="{Binding SelectedMoldeDescricao}"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Contexto da encomenda"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Picker ItemsSource="{Binding ContextosEncomenda}"
                                                SelectedItem="{Binding SelectedContexto}"
                                                ItemDisplayBinding="{Binding ContextoDisplay}"
                                                Title="Seleciona o contexto comercial"
                                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Label Text="{Binding ContextosHint}"
                                               FontSize="12"
                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                    </VerticalStackLayout>

                                    <VerticalStackLayout Spacing="6">
                                        <Label Text="Tipo de relatorio"
                                               FontFamily="OpenSansSemibold"
                                               FontSize="13"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                        <Picker ItemsSource="{Binding TiposRelatorio}"
                                                SelectedItem="{Binding SelectedTipoRelatorio}"
                                                Title="Seleciona o relatorio"
                                                BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                                TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    </VerticalStackLayout>

                                    <Grid ColumnDefinitions="*,*"
                                          ColumnSpacing="12">
                                        <Button Text="{Binding PreviewButtonText}"
                                                Command="{Binding PreviewCommand}"
                                                IsEnabled="{Binding CanPreview}"
                                                HeightRequest="46"
                                                BackgroundColor="{AppThemeBinding Light=#DBEAFE, Dark=#1D4ED8}"
                                                TextColor="{AppThemeBinding Light=#1D4ED8, Dark=White}" />

                                        <Button Grid.Column="1"
                                                Text="{Binding GenerateButtonText}"
                                                Command="{Binding GenerateCommand}"
                                                IsEnabled="{Binding CanGenerate}"
                                                HeightRequest="46"
                                                BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                                TextColor="{AppThemeBinding Light=White, Dark=#0F172A}" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Border>

                            <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                                    Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                    StrokeThickness="1"
                                    Padding="20">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="24" />
                                </Border.StrokeShape>

                                <VerticalStackLayout Spacing="12">
                                    <Label Text="{Binding PreviewTitulo}"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="18"
                                           TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />

                                    <Label Text="{Binding PreviewResumo}"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                            StrokeThickness="0"
                                            Padding="14">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>

                                        <Label Text="{Binding PreviewDetalhes}"
                                               LineBreakMode="WordWrap"
                                               TextColor="{AppThemeBinding Light={StaticResource TextPrimary}, Dark={StaticResource White}}" />
                                    </Border>

                                    <Label Text="{Binding PreviewOrigem}"
                                           IsVisible="{Binding HasPreview}"
                                           FontSize="12"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>
                            </Border>
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
