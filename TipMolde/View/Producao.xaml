<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:TipMolde.Models"
             xmlns:viewmodel="clr-namespace:TipMolde.ViewModel"
             xmlns:shared="clr-namespace:TipMolde.View.Shared"
             x:Class="TipMolde.View.Producao"
             x:Name="PaginaProducao"
             BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">

    <Grid ColumnDefinitions="Auto,*"
          ColumnSpacing="0">

        <shared:SidebarView Grid.Column="0" />

        <Grid Grid.Column="1"
              RowDefinitions="Auto,*"
              BackgroundColor="{AppThemeBinding Light={StaticResource Surface}, Dark={StaticResource OffBlack}}">
            <shared:TopBarView Grid.Row="0"
                               TitleText="Gestao de Producao" />

            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="{OnIdiom Phone='16,16,16,14', Desktop='28,22,28,18'}"
                                     Spacing="18">


                    <FlexLayout Direction="Row"
                                Wrap="Wrap"
                                AlignItems="Center"
                                JustifyContent="SpaceBetween">
                        <Label Text="Podes abrir a fila global de moldes ou trabalhar diretamente a partir da fila de pecas disponiveis."
                               FlexLayout.Grow="1"
                               Margin="0,0,16,10"
                               VerticalOptions="Center"
                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />

                        <HorizontalStackLayout Spacing="10"
                                               Margin="0,0,0,10">
                            <Button Text="Registo Ativo"
                                    Command="{Binding AbrirRegistoAtivoCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                    TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    HeightRequest="44"
                                    HorizontalOptions="End" />

                            <Button Text="Fila de Moldes"
                                    Command="{Binding AbrirFilaTrabalhoCommand}"
                                    BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                    TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                    HeightRequest="44"
                                    HorizontalOptions="End" />
                        </HorizontalStackLayout>
                    </FlexLayout>

                    <ActivityIndicator IsRunning="{Binding IsLoading}"
                                       IsVisible="{Binding IsLoading}"
                                       HorizontalOptions="Center" />

                    <Label Text="{Binding ErrorMessage}"
                           IsVisible="{Binding HasError}"
                           TextColor="{AppThemeBinding Light={StaticResource Danger}, Dark=#FCA5A5}"
                           FontSize="13" />

                    <Border BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource Gray950}}"
                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                            StrokeThickness="1"
                            Padding="20">
                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="24" />
                        </Border.StrokeShape>

                        <VerticalStackLayout Spacing="16">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="12">
                                <VerticalStackLayout Spacing="4">
                                    <Label Text="Lista de pecas disponiveis"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="20" />
                                    <Label Text="Ordenadas por prioridade de molde e depois por prioridade da peca."
                                           FontSize="13"
                                           TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                </VerticalStackLayout>

                                <Label Grid.Column="1"
                                       Text="{Binding TotalItems, StringFormat='Total: {0}'}"
                                       VerticalOptions="Center"
                                       TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                            </Grid>

                            <VerticalStackLayout Spacing="10">
                                    <Label Text="Pesquisar producao"
                                           FontFamily="OpenSansSemibold"
                                           FontSize="14" />

                                <FlexLayout Direction="Row"
                                            Wrap="Wrap"
                                            AlignItems="Center">
                                    <Picker Title="Pesquisar por"
                                            WidthRequest="{OnIdiom Phone='170', Desktop='190'}"
                                            Margin="0,0,10,10"
                                            ItemsSource="{Binding SearchModes}"
                                            SelectedIndex="{Binding SelectedSearchModeIndex}" />

                                    <SearchBar Placeholder="Pesquisar por molde ou peca"
                                               FlexLayout.Grow="1"
                                               Margin="0,0,10,10"
                                               Text="{Binding SearchTerm}"
                                               SearchCommand="{Binding PesquisarCommand}" />

                                    <Button Text="Pesquisar"
                                            Margin="0,0,10,10"
                                            Command="{Binding PesquisarCommand}"
                                            BackgroundColor="{AppThemeBinding Light=#E2E8F0, Dark=#1E293B}"
                                            TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                            HeightRequest="42" />

                                    <Button Text="Limpar"
                                            Margin="0,0,0,10"
                                            Command="{Binding LimparPesquisaCommand}"
                                            IsEnabled="{Binding HasSearch}"
                                            BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                            TextColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                            HeightRequest="42" />
                                </FlexLayout>
                            </VerticalStackLayout>

                            <CollectionView ItemsSource="{Binding PecasDisponiveis}"
                                            SelectionMode="None">
                                <CollectionView.ItemsLayout>
                                    <LinearItemsLayout Orientation="Vertical"
                                                       ItemSpacing="14" />
                                </CollectionView.ItemsLayout>

                                <CollectionView.EmptyView>
                                    <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                            Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                            StrokeThickness="1"
                                            Padding="20">
                                        <Border.StrokeShape>
                                            <RoundRectangle CornerRadius="18" />
                                        </Border.StrokeShape>
                                        <Label Text="{x:Static viewmodel:ProducaoViewModel.EmptyPecasMessage}"
                                               HorizontalOptions="Center" />
                                    </Border>
                                </CollectionView.EmptyView>

                                <CollectionView.ItemTemplate>
                                    <DataTemplate x:DataType="models:ProducaoPecaDisponivelItem">
                                        <Border BackgroundColor="{AppThemeBinding Light=#F8FAFC, Dark=#111827}"
                                                Stroke="{AppThemeBinding Light={StaticResource CardBorderBrush}, Dark={StaticResource Gray600Brush}}"
                                                StrokeThickness="1"
                                                Padding="18">
                                            <Border.StrokeShape>
                                                <RoundRectangle CornerRadius="20" />
                                            </Border.StrokeShape>

                                            <Grid ColumnDefinitions="*,Auto"
                                                  ColumnSpacing="14">
                                                <VerticalStackLayout Spacing="8">
                                                    <Label Text="{Binding DesignacaoDisplay}"
                                                           FontFamily="OpenSansSemibold"
                                                           FontSize="18" />

                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="12">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding NumeroMoldeDisplay, StringFormat='Molde: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding NumeroEncomendaDisplay, StringFormat='Encomenda: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,*,*"
                                                          ColumnSpacing="12">
                                                        <Label Grid.Column="0"
                                                               Text="{Binding NumeroPecaDisplay, StringFormat='Numero peca: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding Quantidade, StringFormat='Qtd: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        <Label Grid.Column="2"
                                                               Text="{Binding ProximaFaseDisplay, StringFormat='Proxima fase: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                    </Grid>

                                                    <Grid ColumnDefinitions="*,*"
                                                          ColumnSpacing="12">
                                                        <Label Text="{Binding EntregaDisplay, StringFormat='Entrega: {0}'}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                        <Label Grid.Column="1"
                                                               Text="{Binding EstadoAtualDisplay}"
                                                               TextColor="{AppThemeBinding Light={StaticResource TextSecondary}, Dark={StaticResource SecondaryDarkText}}" />
                                                    </Grid>

                                                    <Label Text="{Binding ProximoPassoDisplay, StringFormat='Proximo passo: {0}'}"
                                                           FontSize="12"
                                                           LineBreakMode="WordWrap"
                                                           TextColor="{AppThemeBinding Light=#0F172A, Dark=#E5E7EB}" />
                                                </VerticalStackLayout>

                                                <Button Grid.Column="1"
                                                        Text="Selecionar"
                                                        Command="{Binding BindingContext.SelecionarPecaCommand, Source={x:Reference PaginaProducao}}"
                                                        CommandParameter="{Binding .}"
                                                        BackgroundColor="{AppThemeBinding Light=#0F172A, Dark=White}"
                                                        TextColor="{AppThemeBinding Light=White, Dark=#0F172A}"
                                                        HeightRequest="42"
                                                        VerticalOptions="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </CollectionView.ItemTemplate>
                            </CollectionView>

                            <shared:PaginationBarView Page="{Binding Page}"
                                                      TotalPages="{Binding TotalPages}"
                                                      PageInput="{Binding PageInput}"
                                                      CanGoFirst="{Binding CanGoFirst}"
                                                      CanGoPrevious="{Binding CanGoPrevious}"
                                                      CanGoNext="{Binding CanGoNext}"
                                                      CanGoLast="{Binding CanGoLast}"
                                                      FirstPageCommand="{Binding FirstPageCommand}"
                                                      PreviousPageCommand="{Binding PreviousPageCommand}"
                                                      GoToPageCommand="{Binding GoToPageCommand}"
                                                      NextPageCommand="{Binding NextPageCommand}"
                                                      LastPageCommand="{Binding LastPageCommand}" />
                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>
            </ScrollView>
        </Grid>
    </Grid>
</ContentPage>
